@{
    ViewData["Title"] = "Take Order";
    Layout = "~/Views/Shared/_WaiterLayout.cshtml";
}

<style>
    .page-container {
        padding: 25px;
        background: #f6f1eb;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
    }

    .page-subtitle {
        color: #8b6f5c;
    }

    .bell {
        width: 40px;
        height: 40px;
        background: #efe7df;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        position: relative;
    }

    .red-dot {
        position: absolute;
        top: 5px;
        right: 6px;
        width: 8px;
        height: 8px;
        background: red;
        border-radius: 50%;
    }

    .card {
        background: #efe7df;
        border-radius: 20px;
        padding: 20px;
        margin-top: 20px;
    }

    .menu-item {
        display: flex;
        justify-content: space-between;
        padding: 15px 0;
        border-bottom: 1px solid #ddd;
    }

    .add-btn {
        border-radius: 50%;
        width: 35px;
        height: 35px;
        border: 1px solid #e8611c;
        color: #e8611c;
        cursor: pointer;
    }

    .tag {
        background: #e6ddd4;
        padding: 5px 10px;
        border-radius: 10px;
    }

    .cart-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .empty-cart {
        text-align: center;
        margin-top: 30px;
        color: #8b6f5c;
    }

    .page-container,
    .page-container h1,
    .page-container h2,
    .page-container h3,
    .page-container h4,
    .page-container p,
    .page-container div,
    .page-container span,
    .page-container label,
    .page-container small {
        color: #000 !important;
    }

    input,
    select,
    textarea,
    .input-box {
        color: #000 !important;
        background: #fff !important;
    }

        input::placeholder {
            color: #666 !important;
        }

    .menu-item,
    .cart-item {
        color: #000 !important;
    }

    .empty-cart {
        color: #000 !important;
    }

    .add-btn {
        color: #e8611c !important;
        background: white !important;
    }

        .add-btn:hover {
            background: #e8611c !important;
            color: white !important;
        }

    .bell {
        color: #000 !important;
    }

    .place-order-btn {
        width: 100%;
        margin-top: 10px;
        padding: 12px;
        border: none;
        background: #e8611c;
        color: white;
        border-radius: 8px;
        cursor: pointer;
        font-size: 16px;
        font-weight: 600;
    }

        .place-order-btn:hover {
            background: #cf5314;
        }
</style>

<div class="page-container">

    <div class="header">
        <div>
            <div class="page-title">Take Order</div>
            <div class="page-subtitle">Add items to place an order.</div>
        </div>

        <div style="display:flex; gap:10px;">
            <div class="bell">🔔<span class="red-dot"></span></div>
            <div>
                <div id="shiftText"></div>
                <small id="dateText"></small>
            </div>
        </div>
    </div>

    <!-- ✅ VEG MENU -->
    <div class="card">
        <h3>Veg Pizzas <span class="tag">VEG</span></h3>

        <div class="menu-item">
            <div>
                <b>Margherita</b><br />₹299
            </div>
            <button class="add-btn" onclick="addItem('Margherita',299)">+</button>
        </div>

        <div class="menu-item">
            <div>
                <b>Farmhouse</b><br />₹349
            </div>
            <button class="add-btn" onclick="addItem('Farmhouse',349)">+</button>
        </div>

        <div class="menu-item">
            <div>
                <b>Paneer Tikka</b><br />₹379
            </div>
            <button class="add-btn" onclick="addItem('Paneer Tikka',379)">+</button>
        </div>
    </div>

    <!-- ✅ NON VEG MENU -->
    <div class="card">
        <h3>Non‑Veg Pizzas <span class="tag">NON‑VEG</span></h3>

        <div class="menu-item">
            <div>
                <b>Chicken Dominator</b><br />₹449
            </div>
            <button class="add-btn" onclick="addItem('Chicken Dominator',449)">+</button>
        </div>

        <div class="menu-item">
            <div>
                <b>BBQ Chicken</b><br />₹419
            </div>
            <button class="add-btn" onclick="addItem('BBQ Chicken',419)">+</button>
        </div>
    </div>

    <!-- ✅ CART -->
    <div class="card">
        <h3>Order Cart</h3>

        <div id="cartItems"></div>

        <div id="emptyCart" class="empty-cart">
            Cart is empty<br />
            Add items from the menu to start an order
        </div>

        <h4 id="totalPrice"></h4>

        <button onclick="placeOrder()" class="place-order-btn">
            Place Order
        </button>
    </div>

</div>

<script>

    let cart = [];

    function addItem(name, price) {
        cart.push({ name, price });
        renderCart();
    }

    function renderCart() {

        const container = document.getElementById("cartItems");
        const empty = document.getElementById("emptyCart");

        container.innerHTML = "";

        if (cart.length === 0) {
            empty.style.display = "block";
            document.getElementById("totalPrice").innerText = "";
            return;
        }

        empty.style.display = "none";

        let total = 0;

        cart.forEach(item => {

            total += item.price;

            container.innerHTML += `
                <div class="cart-item">
                    ${item.name} - ₹${item.price}
                </div>`;
        });

        document.getElementById("totalPrice").innerText = "Total: ₹" + total;
    }

    function placeOrder() {

        fetch('/Order/createOrder', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                items: cart
            })
        })
        .then(() => {
            alert("✅ Order placed!");
            cart = [];
            renderCart();
        });
    }

    function updateShift() {

        let h = new Date().getHours();

        let shift =
            h < 14 ? "Morning" :
            h < 22 ? "Afternoon" :
            "Night";

        document.getElementById("shiftText").innerText = "Shift: " + shift;

        document.getElementById("dateText").innerText =
            new Date().toLocaleDateString("en-IN", {
                day: '2-digit',
                month: 'short'
            });
    }

    updateShift();

</script>