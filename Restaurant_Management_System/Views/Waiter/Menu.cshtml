@using Restaurant_Management_System.Data;
@using Restaurant_Management_System.ENUM;
@model IEnumerable<Restaurant_Management_System.Models.MenuItem>

@{
    Layout = "~/Views/Shared/_WaiterLayout.cshtml";
    ViewData["Title"] = "Restaurant Menu";
}

<div class="container mt-4">
    <h2 class="mb-4 fw-bold text-center">
        Restaurant Menu
    </h2>
    <div class="row">
        @foreach (var item in Model)
        {
            bool isAvailable = item.ItemStatus == ItemStatus.AVAILABLE;

            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="card shadow-sm h-100 border-0 @(isAvailable ? "" : "item-disabled")">

                    <!-- Fixed Image Rendering for Menu Card -->
                    <img src="@(string.IsNullOrEmpty(item.ImagePath) ? "/images/menu/default-placeholder.png" : item.ImagePath)"
                         class="card-img-top img-fluid"
                         alt="@item.ItemName"
                         style="height: 180px; object-fit: cover; border-top-left-radius: .25rem; border-top-right-radius: .25rem;" />

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">
                            @item.ItemName
                        </h5>
                        <span class="badge bg-primary mb-2">
                            @item.Category
                        </span>
                        @if (isAvailable)
                        {
                            <span class="badge bg-success mb-2">
                                Available
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger mb-2">
                                Out Of Stock
                            </span>
                        }

                        <h4 class="text-danger">
                            ₹@item.Price
                        </h4>
                        <div class="mt-auto">
                            <button class="btn btn-outline-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#modal_@item.MenuItemId">
                                View Details
                            </button>
                            <button class="btn btn-warning w-100" disabled="@(!isAvailable)" onclick="addToCart(@item.MenuItemId,'@item.ItemName',@item.Price)">
                                Add To Cart
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal -->
            <div class="modal fade" id="modal_@item.MenuItemId" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h4 class="modal-title">
                                @item.ItemName
                            </h4>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <!-- Fixed Image Rendering inside Modal -->
                                    <img src="@(string.IsNullOrEmpty(item.ImagePath) ? "/images/menu/default-placeholder.png" : item.ImagePath)"
                                         class="img-fluid rounded w-100"
                                         alt="@item.ItemName" />
                                </div>
                                <div class="col-md-6">
                                    <h5>
                                        Category :
                                        <span class="text-success">
                                            @item.Category
                                        </span>
                                    </h5>
                                    <p class="mt-3">
                                        <strong>Status :</strong>
                                        @if (isAvailable)
                                        {
                                            <span class="badge bg-success">
                                                Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Out Of Stock
                                            </span>
                                        }
                                    </p>
                                    <h4 class="text-danger mt-3">
                                        ₹@item.Price
                                    </h4>
                                    <p class="mt-3">
                                        <strong>Preparation Time :</strong> @item.PreparationTime Minutes
                                    </p>
                                    <p>
                                        <strong>Recipe :</strong>
                                        @(string.IsNullOrWhiteSpace(item.RecipeSteps) ? "No Description Available" : item.RecipeSteps)
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-warning" disabled="@(!isAvailable)">
                                Add To Cart
                            </button>
                            <button class="btn btn-secondary" data-bs-dismiss="modal">
                                Close
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>