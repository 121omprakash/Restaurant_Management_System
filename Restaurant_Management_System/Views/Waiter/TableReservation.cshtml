@{
    ViewData["Title"] = "Table Reservation";
    Layout = "~/Views/Shared/_WaiterLayout.cshtml";
}

<style>
    .page-container {
        padding: 30px;
        background: #f6f1eb;
    }



    /* TEXT */
    .page-title {
        font-size: 28px;
        font-weight: 700;
    }

    .page-subtitle {
        color: #8b6f5c;
        margin-bottom: 20px;
    }

    /* CARD */
    .reservation-card {
        width: 420px;
        background: #efe7df;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0px 8px 20px rgba(0,0,0,0.08);
    }

    .label {
        margin-top: 15px;
    }

    /* INPUT */
    .input-box {
        width: 100%;
        padding: 14px;
        border-radius: 20px;
        border: none;
        background: #e6ddd4;
    }

    /* BUTTON */
    .btn-reserve {
        width: 100%;
        margin-top: 20px;
        padding: 14px;
        border-radius: 25px;
        background: #d9cec3;
        border: none;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-reserve:hover {
            background: #e8681c;
            color: white;
        }

    /* FLOOR GRID */
    .floor-section {
        margin-top: 40px;
    }

    .floor-title {
        font-size: 22px;
        font-weight: bold;
    }

    /* GRID */
    .floor-grid {
        display: grid;
        grid-template-columns: repeat(6, 130px);
        gap: 20px;
    }

    /* TABLE */
    .table-card {
        border-radius: 20px;
        padding: 20px;
        text-align: center;
        cursor: pointer;
        border: 2px solid transparent;
    }

    /* NUMBER */
    .table-number {
        width: 55px;
        height: 55px;
        border-radius: 50%;
        line-height: 55px;
        margin: auto;
        color: white;
        font-weight: bold;
    }

    /* STATUS COLORS */
    .available {
        background: #e6f4ef;
        border-color: #1abc9c;
    }

        .available .table-number {
            background: #1abc9c;
        }

    .occupied {
        background: #fceae2;
        border-color: #e8611c;
    }

        .occupied .table-number {
            background: #e8611c;
        }

    .reserved {
        background: #fff6e0;
        border-color: #f4b400;
    }

        .reserved .table-number {
            background: #f4b400;
        }

    /* TEXT */
    .status {
        margin-top: 10px;
        font-weight: bold;
    }

    .customer-name {
        font-size: 13px;
    }

    /* LEGEND */
    .dot {
        height: 10px;
        width: 10px;
        display: inline-block;
        border-radius: 50%;
        margin: 0 5px;
    }

    .green {
        background: #1abc9c;
    }

    .orange {
        background: #e8611c;
    }

    .yellow {
        background: #f4b400;
    }

    /* DROPDOWN */
    .status-select {
        margin-top: 8px;
        border-radius: 10px;

    }
</style>



<div class="page-container">

    <div class="page-title">Table Reservation</div>
    <div class="page-subtitle">Reserve tables and view floor status.</div>

    <!-- FORM -->
    <div class="reservation-card">

        <h3>New Reservation</h3>

        <div class="label">Table Number</div>
        <select id="tableNumber" class="input-box"></select>

        <div class="label">Customer Name</div>
        <input id="customerName" class="input-box" placeholder="Enter name" />

        <button class="btn-reserve" onclick="reserveTable()">Reserve Table</button>



    </div>

    <!-- FLOOR -->
    <div class="floor-section">
        <div class="floor-title">Floor Map</div>

        <div id="floorGrid" class="floor-grid"></div>

        <div style="margin-top:20px;">
            <span class="dot green"></span> Available
            <span class="dot orange"></span> Occupied
            <span class="dot yellow"></span> Reserved
        </div>
    </div>

</div>


<script>
    let tables = [];

    // ✅ INITIALIZE 12 TABLES
    for (let i = 1; i <= 6; i++) {
        tables.push({
            id: i,
            status: "available",
            customer: ""
        });
    }

    function renderTables() {

        const grid = document.getElementById("floorGrid");
        grid.innerHTML = "";

        tables.forEach(t => {

            const div = document.createElement("div");
            div.className = `table-card ${t.status}`;

            div.innerHTML = `
                <div class="table-number">${t.id}</div>
                <div class="status">${t.status.toUpperCase()}</div>
                <div class="customer-name">${t.customer || ""}</div>

                <select class="status-select" onchange="changeStatus(${t.id}, this.value)">
                    <option value="available">Available</option>
                    <option value="occupied">Occupied</option>
                    <option value="reserved">Reserved</option>
                </select>
            `;

            div.onclick = () => selectTable(t.id);

            grid.appendChild(div);
        });
    }

    // ✅ SELECT TABLE
    function selectTable(id) {
        document.getElementById("tableNumber").value = id;
    }

    // ✅ CHANGE STATUS
    function changeStatus(id, newStatus) {
        const table = tables.find(t => t.id === id);
        table.status = newStatus;
        renderTables();
    }

    // ✅ FILL DROPDOWN
    function populateDropdown() {
        const dropdown = document.getElementById("tableNumber");
        dropdown.innerHTML = `<option value="">Select table</option>`;

        tables.forEach(t => {
            dropdown.innerHTML += `<option value="${t.id}">Table ${t.id}</option>`;
        });
    }

    // ✅ RESERVE TABLE
    function reserveTable() {

        const tableId = document.getElementById("tableNumber").value;
        const name = document.getElementById("customerName").value;

        if (!tableId || !name) {
            alert("Fill all fields");
            return;
        }

        const table = tables.find(t => t.id == tableId);

        table.status = "reserved";
        table.customer = name;

        renderTables();

        // ✅ API CALL
        fetch('/Order/reserveTable', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tableNumber: tableId, customerName: name })
        });

        alert("✅ Reserved!");
    }

    // INIT
    populateDropdown();
    renderTables();

</script>
