@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_WaiterLayout.cshtml";
}

<style>
    .dashboard-container {
        padding: 25px;
        background: #f6f1eb;
    }

    
    .top-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .bell {
        font-size: 18px;
        background: #efe7df;
        padding: 10px;
        border-radius: 50%;
    }

  
    .dashboard-cards {
        display: flex;
        gap: 20px;
        margin-top: 20px;
    }

    .dashboard-card {
        flex: 1;
        background: white;
        padding: 20px;
        border-radius: 15px;
        text-align: center;
    }

    .blue {
        background: #e6f0ff;
    }

    .orange {
        background: #fff4e6;
    }

    .green {
        background: #e6f7ef;
    }

    .yellow {
        background: #fff9e6;
    }

    .icon {
        font-size: 22px;
    }

 
    .card {
        background: #efe7df;
        border-radius: 20px;
        padding: 20px;
        margin-top: 20px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

  
    .form-section {
        margin-bottom: 20px;
    }

        .form-section input,
        .form-section select {
            padding: 8px;
            margin: 5px;
            border-radius: 8px;
            border: none;
            background: #fff;
        }

        .form-section button {
            padding: 8px 12px;
            border: none;
            border-radius: 8px;
            background: #e8611c;
            color: white;
            cursor: pointer;
        }

   
    .order-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #ddd;
    }

    .order-left {
        display: flex;
        gap: 10px;
    }

    .table-circle {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: #e6ddd4;
        display: flex;
        align-items: center;
        justify-content: center;
    }


    .status {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        margin-left: 10px;
    }

    .new {
        background: #e0e0e0;
    }

    .preparing {
        background: #fff3cd;
    }

    .ready {
        background: #d4edda;
    }
</style>


<div class="dashboard-container">

  
    <div class="top-header">
        <div>
            <h2>Welcome, Anusha 👋</h2>
            <p>Here’s what’s happening on the floor today.</p>
        </div>

        <div class="header-right">
            <span class="bell">🔔</span>
            <div>
                <b id="shiftText"></b><br />
                <small id="dateText"></small>
            </div>
        </div>
    </div>

   
    <div class="dashboard-cards">

        <div class="dashboard-card blue">
            <div class="icon">👥</div>
            <h3 id="activeTables">4</h3>
            <p>Active Tables</p>
        </div>

        <div class="dashboard-card orange">
            <div class="icon">🔥</div>
            <h3 id="inProgress">2</h3>
            <p>Orders in Progress</p>
        </div>

        <div class="dashboard-card green">
            <div class="icon">✅</div>
            <h3 id="readyOrders">1</h3>
            <p>Ready to Serve</p>
        </div>

    </div>

   
    <div class="card">
        <div class="section-header">
            <h3>Manage Tables & Orders</h3>
        </div>

      
        <div class="form-section">
            <h4>Reserve Table</h4>
            <input type="text" id="customerName" placeholder="Customer Name" />

            <select id="tableNumber">
                <option value="">Select Table</option>
                <option>1</option>
                <option>2</option>
                <option>3</option>
                <option>4</option>
                <option>5</option>
            </select>

            <button onclick="reserveTable()">Reserve</button>
        </div>

      
        <div class="form-section">
            <h4>Create Order</h4>

            <select id="orderType">
                <option value="DINE_IN">Dine-In</option>
                <option value="TAKEAWAY">Takeaway</option>
                <option value="DELIVERY">Delivery</option>
            </select>

            <button onclick="createOrder()">Create</button>
        </div>

      
        <div class="form-section">
            <h4>Add Item</h4>

            <select id="menuItem">
                <option>Margherita</option>
                <option>Farmhouse</option>
                <option>Paneer Tikka</option>
                <option>BBQ Chicken</option>
            </select>

            <input type="number" id="quantity" placeholder="Qty" />

            <button onclick="addItem()">Add</button>
        </div>

    </div>

   
    <div class="card">
        <div class="section-header">
            <h3>Active Orders</h3>
            <span>Today</span>
        </div>

        <div class="order-row">
            <div class="order-left">
                <div class="table-circle">T1</div>
                <div>
                    <b>Rahul Sharma</b><br />
                    Margherita, Chicken Dominator
                </div>
            </div>
            <div>
                12:35 PM
                <span class="status preparing">PREPARING</span>
            </div>
        </div>

        <div class="order-row">
            <div class="order-left">
                <div class="table-circle">T3</div>
                <div>
                    <b>Priya Mehta</b><br />
                    Paneer Tikka
                </div>
            </div>
            <div>
                12:48 PM
                <span class="status ready">READY</span>
            </div>
        </div>

    </div>

</div>


<script>
    let currentOrderId = null;


    function updateHeader(){
        let h = new Date().getHours();
        let shift = h < 14 ? "Morning" : h < 22 ? "Afternoon" : "Night";

        document.getElementById("shiftText").innerText = "Shift: " + shift;
        document.getElementById("dateText").innerText =
            new Date().toLocaleDateString("en-IN",{day:'2-digit', month:'short'});
    }

 
    function reserveTable(){
        alert("✅ Table Reserved");
    }

    function createOrder(){
        currentOrderId = Math.floor(Math.random()*1000);
        alert("✅ Order Created: " + currentOrderId);
    }

    function addItem(){
        alert("✅ Item Added");
    }

   
    updateHeader();
</script>
