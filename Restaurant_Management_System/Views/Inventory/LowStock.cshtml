@using Restaurant_Management_System.ENUM
@model Restaurant_Management_System.ViewModel.InventoryListViewModel
@{
    ViewData["Title"] = "Low Stock";
    Layout = "~/Views/Shared/_InventoryLayout.cshtml";
}

<h2 class="mb-4">Low Stock Items</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Item</th>
            <th>Unit</th>
            <th>Stock</th>
            <th>Reorder Level</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Items != null && Model.Items.Any())
        {
            foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.IngredientName</td>
                    <td>@item.UnitOfMeasure</td>
                    <td>@item.CurrentStock</td>
                    <td>@item.ReorderLevel</td>
                    <td>
                        @if (item.StockStatus == StockStatus.OUT_OF_STOCK)
                        {
                            <span class="badge bg-danger">Out Of Stock</span>
                        }
                        else if (item.StockStatus == StockStatus.LOW)
                        {
                            <span class="badge bg-warning text-dark">Low</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Available</span>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">No low stock items found.</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="InventoryManagement" class="btn btn-secondary">Back to Inventory</a>
