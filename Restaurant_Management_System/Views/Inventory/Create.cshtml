@using Restaurant_Management_System.ENUM
@model Restaurant_Management_System.Models.Ingredient
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_InventoryLayout.cshtml";
}
<h2 class="mb-4">Add New Inventory Item</h2>

<form asp-controller="Inventory"
      asp-action="RecordStockReceipt"
      method="post">
    <div class="mb-3">
        <label>Item Name</label>
        <input asp-for="IngredientName" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Unit Of Measure</label>
        <select asp-for="UnitOfMeasure"
                asp-items="Html.GetEnumSelectList<UnitOfMeasure>()"
                class="form-control">
        </select>
    </div>

    <div class="mb-3">
        <label>Stock Quantity</label>
        <input asp-for="CurrentStock" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Reorder Level</label>
        <input asp-for="ReorderLevel" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Save Item
    </button>

    <a asp-action="InventoryManagement" class="btn btn-secondary">
        Back
    </a>
</form>