@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_InventoryLayout.cshtml";
}

<h2 class="mb-4">Add New Inventory Item</h2>

<form asp-controller="Inventory"
      asp-action="RecordStockReceipt"
      method="post">
    <div class="mb-3">
        <label>Item Name</label>
        <input type="text" name="Name" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Category</label>
        <input type="text" name="Category" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Stock Quantity</label>
        <input type="number" name="Stock" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Reorder Level</label>
        <input type="number" name="ReorderLevel" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Save Item
    </button>

    <a asp-action="InventoryManagement" class="btn btn-secondary">
        Back
    </a>
</form>