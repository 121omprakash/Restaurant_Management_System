@model List<Restaurant_Management_Error.Models.StockItem>

@{
    ViewData["Title"] = "Inventory Management";
    Layout = "~/Views/Shared/_InventoryLayout.cshtml";
}

<div class="container-fluid stock-page">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">Stock Management</h2>
            <p class="page-subtitle">Manage inventory items and stock levels</p>
        </div>


    </div>

    <!-- TABLE CARD -->
    <div class="card p-3">
        <h5 class="mb-3">Inventory List</h5>

        <div class="table-responsive">
            <table class="table align-middle">

                <!-- TABLE HEADER -->
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Category</th>
                        <th>Stock</th>
                        <th>Reorder Level</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <!-- TABLE BODY -->
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Category</td>
                            <td>@item.Stock</td>
                            <td>@item.ReorderLevel</td>

                            <!-- STATUS -->
                            <td>
                                @if (item.Stock < item.ReorderLevel)
                                {
                                    <span class="badge bg-danger">Low</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">In Stock</span>
                                }
                            </td>

                            <!-- ACTION BUTTONS -->
                            @* <td class="action-buttons"> *@
                            <td class="text-center">

                                                               <a 
                                   class="btn btn-sm btn-outline-primary me-2">
                                    <i class="fas fa-edit"></i>                        </a>

                               
                                <a
                                        class="btn btn-sm btn-outline-danger me-2">
                                         <i class="fas fa-trash"></i>
                                 </a>

                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>
