@using Restaurant_Management_System.ENUM
@model Restaurant_Management_System.ViewModel.InventoryListViewModel

@{
    ViewData["Title"] = "Inventory Management";
    Layout = "~/Views/Shared/_InventoryLayout.cshtml";
}

<div class="container-fluid stock-page">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">Stock Management</h2>
            <p class="page-subtitle">Manage inventory items and stock levels</p>
        </div>

        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Ingredient
            </a>
        </div>
    </div>

    <!-- TABLE CARD -->
    <div class="card p-3">
        <h5 class="mb-3">Inventory List</h5>

        <div class="table-responsive">
            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Unit</th>
                        <th>Stock</th>
                        <th>Reorder Level</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Items != null && Model.Items.Any())
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.IngredientName</td>

                                <td>@item.UnitOfMeasure</td>

                                <td>@item.CurrentStock</td>

                                <td>@item.ReorderLevel</td>

                                <td>
                                    @if (item.StockStatus == StockStatus.OUT_OF_STOCK)
                                    {
                                        <span class="badge bg-danger">
                                            Out Of Stock
                                        </span>
                                    }
                                    else if (item.StockStatus == StockStatus.LOW)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Low
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Available
                                        </span>
                                    }
                                </td>

                                <td class="text-center">

                                    <!-- Edit -->
                                    

                                    <!-- Delete -->
                                    <form  class="align-self-sm-auto d-inline-block" asp-action="Delete" asp-route-id="@item.IngredientId" method="post" onsubmit="return confirm('Are you sure you want to delete this ingredient?');">
                                        <a asp-action="Edit" asp-route-id="@item.IngredientId" class="btn btn-sm btn-secondary">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">
                                No inventory items found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        </div>

    </div>

</div>