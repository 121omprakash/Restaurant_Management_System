@model Restaurant_Management_System.Models.Ingredient
@{
    ViewData["Title"] = "Edit Item";
    Layout = "~/Views/Shared/_InventoryLayout.cshtml";
}

<h2 class="mb-4">Edit Inventory Item</h2>

<form asp-controller="Inventory" asp-action="ConsumeIngredients" method="post">
    <input asp-for="IngredientId" type="hidden" />

    <div class="mb-3">
        <label asp-for="IngredientName" class="form-label"></label>
        <input asp-for="IngredientName" class="form-control" />
    </div>

  @*   <div class="mb-3">
        <label asp-for="Category" class="form-label"></label>
        <input asp-for="Category" class="form-co    ntrol" />
    </div> *@

    <div class="mb-3">
        <label asp-for="CurrentStock" class="form-label"></label>
        <input asp-for="CurrentStock" class="form-control" type="number" />
    </div>

    <div class="mb-3">
        <label asp-for="ReorderLevel" class="form-label"></label>
        <input asp-for="ReorderLevel" class="form-control" type="number" />
    </div>

    <button type="submit" class="btn btn-primary">Update Item</button>
    <a asp-action="InventoryManagement" class="btn btn-secondary">Back</a>
</form>
