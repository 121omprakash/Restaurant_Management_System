@model Restaurant_Management_System.ViewModel.InventoryItemViewModel
@using Restaurant_Management_System.ENUM
@{
    ViewData["Title"] = "Edit Item";
    Layout = "~/Views/Shared/_InventoryLayout.cshtml";
}

<h2 class="mb-4">Edit Inventory Item</h2>

<form asp-controller="Inventory" asp-action="ConsumeIngredients" method="post">
    <input asp-for="Ingredient.IngredientId" type="hidden" />

    <div class="mb-3">
        <label asp-for="Ingredient.IngredientName" class="form-label"></label>
        <input asp-for="Ingredient.IngredientName" class="form-control" />
    </div>


    <div class="mb-3">
        <label asp-for="Ingredient.UnitOfMeasure"></label>

        <select asp-for="Ingredient.UnitOfMeasure"
                asp-items="Html.GetEnumSelectList<UnitOfMeasure>()"
                class="form-control">
        </select>
    </div>

  @*   <div class="mb-3">
        <label asp-for="Category" class="form-label"></label>
        <input asp-for="Category" class="form-control" />
    </div> *@

    <div class="mb-3">
        <label asp-for="Ingredient.CurrentStock" class="form-label"></label>
        <input asp-for="Ingredient.CurrentStock" class="form-control" type="number" />
    </div>

    <div class="mb-3">
        <label asp-for="Ingredient.ReorderLevel" class="form-label"></label>
        <input asp-for="Ingredient.ReorderLevel" class="form-control" type="number" />
    </div>

    <button type="submit" class="btn btn-primary">Update Item</button>
    <a asp-action="InventoryManagement" class="btn btn-secondary">Back</a>
</form>
