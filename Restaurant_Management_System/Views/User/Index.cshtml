@model List<Restaurant_Management_System.Models.User>

@{
	ViewData["Title"] = "User Management";
	var currentPage = ViewBag.CurrentPage ?? 1;
	var totalPages = ViewBag.TotalPages ?? 1;
	var totalUsers = ViewBag.TotalUsers ?? 0;
	var searchQuery = ViewBag.SearchQuery ?? "";
}

<div class="container-fluid py-4">
	<!-- Header Section -->
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h1 class="h3 mb-0 text-dark fw-bold">User Management</h1>
			<p class="text-muted small mt-1">Manage system users, roles, and access</p>
		</div>
		<button class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#addUserModal">
			<i class="bi bi-plus-circle"></i> Add User
		</button>
	</div>

	<!-- Search and Info Card -->
	<div class="card border-0 shadow-sm mb-4">
		<div class="card-body p-4">
			<div class="row align-items-center">
				<div class="col-lg-6">
					<div class="input-group input-group-lg">
						<span class="input-group-text bg-light border-0">
							<i class="bi bi-search"></i>
						</span>
						<input type="text" 
							   id="searchInput" 
							   class="form-control form-control-lg border-0 bg-light" 
							   placeholder="Search by username or role..."
							   value="@searchQuery">
					</div>
				</div>
				<div class="col-lg-6 text-end">
					<small class="text-muted">
						<strong>@totalUsers</strong> total users | 
						Page <strong>@currentPage</strong> of <strong>@totalPages</strong>
					</small>
				</div>
			</div>
		</div>
	</div>

	<!-- Users Table Card -->
	<div class="card border-0 shadow-sm">
		<div class="table-responsive">
			<table class="table table-hover mb-0">
				<thead class="table-light">
					<tr>
						<th class="ps-4 py-3 border-bottom">
							<strong>ID</strong>
						</th>
						<th class="py-3 border-bottom">
							<strong>Username</strong>
						</th>
						<th class="py-3 border-bottom">
							<strong>Role</strong>
						</th>
						<th class="py-3 border-bottom">
							<strong>Status</strong>
						</th>
						<th class="text-center py-3 border-bottom pe-4">
							<strong>Actions</strong>
						</th>
					</tr>
				</thead>
				<tbody id="usersTableBody">
					@if (Model != null && Model.Count > 0)
					{
						@foreach (var user in Model)
						{
							<tr class="user-row" data-user-id="@user.Id">
								<td class="ps-4 py-3 align-middle">
									<span class="badge bg-light text-dark">@user.Id</span>
								</td>
								<td class="py-3 align-middle">
									<div class="fw-500">@user.UserId</div>
								</td>
								<td class="py-3 align-middle">
									<span class="badge bg-info">@user.Role</span>
								</td>
								@* <td class="py-3 align-middle">
									@if (user.Status == "Active")
									{
										<span class="badge bg-success">
											<i class="bi bi-check-circle-fill"></i> Active
										</span>
									}
									else
									{
										<span class="badge bg-danger">
											<i class="bi bi-x-circle-fill"></i> Inactive
										</span>
									}
								</td> *@
								<td class="text-center py-3 align-middle pe-4">
									<button class="btn btn-sm btn-outline-primary edit-btn" 
											data-user-id="@user.Id"
											data-bs-toggle="tooltip" 
											title="Edit User">
										<i class="bi bi-pencil-square"></i>
									</button>
									<button class="btn btn-sm btn-outline-danger delete-btn" 
											data-user-id="@user.Id"
											data-bs-toggle="tooltip" 
											title="Delete User">
										<i class="bi bi-trash"></i>
									</button>
								</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="5" class="text-center py-5">
								<div class="text-muted">
									<i class="bi bi-inbox" style="font-size: 2rem;"></i>
									<p class="mt-2">No users found</p>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>

		<!-- Pagination -->
		@if (totalPages > 1)
		{
			<div class="card-footer bg-light border-top py-4">
				<nav class="d-flex justify-content-center" aria-label="Page navigation">
					<ul class="pagination mb-0">
						@if (currentPage > 1)
						{
							<li class="page-item">
								<a class="page-link" href="@Url.Action("Index", new { page = 1, search = searchQuery })">First</a>
							</li>
							<li class="page-item">
								<a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, search = searchQuery })">Previous</a>
							</li>
						}

						@for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
						{
							if (i == currentPage)
							{
								<li class="page-item active"><span class="page-link">@i</span></li>
							}
							else
							{
								<li class="page-item"><a class="page-link" href="@Url.Action("Index", new { page = i, search = searchQuery })">@i</a></li>
							}
						}

						@if (currentPage < totalPages)
						{
							<li class="page-item">
								<a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, search = searchQuery })">Next</a>
							</li>
							<li class="page-item">
								<a class="page-link" href="@Url.Action("Index", new { page = totalPages, search = searchQuery })">Last</a>
							</li>
						}
					</ul>
				</nav>
			</div>
		}
	</div>
</div>

<!-- Add/Edit User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content border-0 shadow">
			<div class="modal-header bg-primary text-white border-0 py-4">
				<h5 class="modal-title fw-bold" id="addUserModalLabel">
					<i class="bi bi-person-plus-fill"></i> Add New User
				</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form id="userForm">
				<div class="modal-body p-4">
					<input type="hidden" id="userId" name="id">

					<div class="mb-3">
						<label for="username" class="form-label fw-600">Username *</label>
						<input type="text" 
							   id="username" 
							   name="userId" 
							   class="form-control form-control-lg" 
							   placeholder="Enter username"
							   required>
						<small class="text-muted d-block mt-1">Unique identifier for the user</small>
					</div>

					<div class="mb-3">
						<label for="password" class="form-label fw-600">Password *</label>
						<input type="password" 
							   id="password" 
							   name="password" 
							   class="form-control form-control-lg" 
							   placeholder="Enter password"
							   required>
						<small class="text-muted d-block mt-1">Minimum 6 characters</small>
					</div>

					<div class="mb-3">
						<label for="role" class="form-label fw-600">Role *</label>
						<select id="role" name="role" class="form-select form-select-lg" required>
							<option value="">-- Select Role --</option>
							<option value="Admin">Admin</option>
							<option value="Chef">Chef</option>
							<option value="Manager">Manager</option>
							<option value="Waiter">Waiter</option>
							<option value="Cashier">Cashier</option>
							<option value="Inventory Clerk">Inventory Clerk</option>
						</select>
					</div>

					<div class="mb-3">
						<label for="status" class="form-label fw-600">Status *</label>
						<select id="status" name="status" class="form-select form-select-lg" required>
							<option value="Active">Active</option>
							<option value="Inactive">Inactive</option>
						</select>
					</div>

					<div id="formMessage" class="alert d-none" role="alert"></div>
				</div>
				<div class="modal-footer bg-light border-top py-3 px-4">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
					<button type="submit" class="btn btn-primary btn-lg px-4">
						<i class="bi bi-check-circle"></i> Save User
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content border-0 shadow">
			<div class="modal-header bg-danger text-white border-0 py-4">
				<h5 class="modal-title fw-bold" id="deleteConfirmLabel">
					<i class="bi bi-exclamation-triangle-fill"></i> Confirm Delete
				</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body p-4">
				<p class="mb-0">Are you sure you want to delete this user? This action cannot be undone.</p>
			</div>
			<div class="modal-footer bg-light border-top py-3 px-4">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-danger btn-lg px-4" id="confirmDeleteBtn">
					<i class="bi bi-trash"></i> Delete
				</button>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<!-- Bootstrap Icons CDN -->
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
	<script src="~/js/user-management.js"></script>
}
