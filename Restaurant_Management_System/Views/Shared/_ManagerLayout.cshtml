<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restaurant Management System (Manager)</title>

    <script>
            (function () {
                const activeTheme = localStorage.getItem("theme") || "day";
                if (activeTheme === "dark" || activeTheme === "night") {
                    document.documentElement.classList.add("dark-theme");
                    document.documentElement.setAttribute("data-theme", "dark");
                } else {
                    document.documentElement.classList.remove("dark-theme");
                    document.documentElement.setAttribute("data-theme", "light");
                }
            })();
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/manager.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Restaurant_Management_System.styles.css" asp-append-version="true" />

    <!-- Styles migrated to wwwroot/css/manager.css -->
</head>
<body>
    <div class="master-layout">

        <header>
            <nav class="navbar navbar-expand-md custom-navbar box-shadow">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Manager" asp-action="Dashboard">
                        <img src="~/download_logo.png" alt="Logo" />
                    </a>
                    <div>
                        <div class="d-flex align-items-center gap-2 ms-auto pt-2 pt-md-0">
                            <button id="themeToggle" class="theme-toggle-btn" aria-label="Toggle System Theme">
                                <i id="themeIcon" class="fa-solid fa-moon"></i>
                                <span id="themeText">Night Mode</span>
                            </button>
                            <a style="text-decoration:none;" class="theme-toggle-btn" asp-controller="Employee" asp-action="Login">
                                <i class="fa-solid fa-right-from-bracket"></i>
                                <span class="sidebar-text">Logout</span>
                            </a>

                        </div>

                    </div>
                </div>
                
            </nav>
        </header>

        <div class="content-workspace">

            <aside class="sidebar position-relative">
                
                <div>
                    <div class="profile">
                        <div class="logo-container">
                            <img src="/ManagerLogo.png" class="logo" alt="Manager Logo" onerror="this.src='https://placehold.co/80?text=RMS';" />
                        </div>
                        <h4 class="sidebar-text">Welcome Back, Satya</h4>
                        <small class="sidebar-text">@(User.Identity.IsAuthenticated ? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value : "Manager")</small>
                    </div>

                    <div class="sidebar-nav-container">
                        <ul id="managerSidebarMenu">
                            <li data-menu="Dashboard">
                                <a asp-controller="Manager" asp-action="Dashboard">
                                    <i class="fa-solid fa-chart-line"></i>
                                    <span class="sidebar-text">Dashboard</span>
                                </a>
                            </li>
                            <li data-menu="Inventory">
                                <a asp-controller="Manager" asp-action="Inventory">
                                    <i class="fa-solid fa-boxes-stacked"></i>
                                    <span class="sidebar-text">Inventory</span>
                                </a>
                            </li>
                            <li data-menu="MenuManagement">
                                <a asp-controller="Manager" asp-action="MenuManagement">
                                    <i class="fa-solid fa-utensils"></i>
                                    <span class="sidebar-text">Menu Management</span>
                                </a>
                            </li>
                            <li data-menu="OrderMonitoring">
                                <a asp-controller="Manager" asp-action="OrderMonitoring">
                                    <i class="fa-solid fa-clipboard-list"></i>
                                    <span class="sidebar-text">Order Monitoring</span>
                                </a>
                            </li>
                            <li data-menu="TableManagement">
                                <a asp-controller="Manager" asp-action="TableManagement">
                                    <i class="fa-solid fa-chair"></i>
                                    <span class="sidebar-text">Table Management</span>
                                </a>
                            </li>
                            <li data-menu="Reports">
                                <a asp-controller="Manager" asp-action="Reports">
                                    <i class="fa-solid fa-chart-pie"></i>
                                    <span class="sidebar-text">Reports</span>
                                </a>
                            </li>
                      
                        </ul>
                    </div>
                </div>

            
            </aside>

            <div class="main-content container-fluid px-4 pt-3">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

        </div>

        <footer class="custom-footer text-muted">
            <div class="w-100 text-center py-2">
                &copy; 2026 - RMSystem - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Sidebar Toggle Mechanics
            const toggleBtn = document.getElementById("sidebarToggle");
            const sidebar = document.querySelector(".sidebar");
            if (toggleBtn && sidebar) {
                toggleBtn.addEventListener("click", function () {
                    sidebar.classList.toggle("collapsed");
                });
            }

            // 2. Dynamic Auto-Highlight Link Match Engine
            const currentPath = window.location.pathname.replace(/\/$/, '').toLowerCase();
            const menuItems = document.querySelectorAll("#managerSidebarMenu li");

            menuItems.forEach(item => {
                const link = item.querySelector('a');
                const actionTarget = (item.getAttribute("data-menu") || '').toLowerCase();
                if (link) {
                    const linkPath = new URL(link.href, location.origin).pathname.replace(/\/$/, '').toLowerCase();
                    if (
                        linkPath === currentPath ||
                        currentPath.includes(actionTarget) ||
                        currentPath.startsWith(linkPath) ||
                        linkPath.startsWith(currentPath)
                    ) {
                        item.classList.add('active');
                    }
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>