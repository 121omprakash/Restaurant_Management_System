<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chef Panel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet" href="~/css/chef.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md custom-navbar fixed-top">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/download_logo.png" alt="RMS Logo" />
                </a>
                <button class="navbar-toggler text-light" type="button" style="filter: invert(1);" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <div class="d-flex align-items-center ms-auto pt-2 pt-md-0">
                        <button id="themeToggle" class="theme-toggle-btn" aria-label="Toggle System Theme">
                            <i id="themeIcon" class="fa-solid fa-moon"></i>
                            <span id="themeText">Night Mode</span>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="sidebar">
        <div class="chef-profile">
            <div class="profile-image">
                <i class="fa-solid fa-utensils"></i>
            </div>
            <div class="profile-details">
                <h5>Saikiran</h5>
                <p>Head Chef</p>
            </div>
        </div>
        <hr />
        <ul class="nav-menu">
            <li>
                <a asp-controller="Kitchen" asp-action="Dashboard"
                   class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active-menu" : "")">
                    <i class="fa-solid fa-house"></i> Dashboard
                </a>
            </li>
            <li>
                <a asp-controller="Kitchen" asp-action="PendingOrders"
                   class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "PendingOrders" ? "active-menu" : "")">
                    <i class="fa-solid fa-clock"></i> Pending Orders
                </a>
            </li>
            <li>
                <a asp-controller="Kitchen" asp-action="PreparingOrders"
                   class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "PreparingOrders" ? "active-menu" : "")">
                    <i class="fa-solid fa-fire-burner"></i> Preparing Orders
                </a>
            </li>
            <li>
                <a asp-controller="Kitchen" asp-action="DelayedOrders"
                   class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "DelayedOrders" ? "active-menu" : "")">
                    <i class="fa-solid fa-triangle-exclamation"></i> Delayed Orders
                </a>
            </li>
            <li>
                <a asp-controller="Kitchen" asp-action="CompletedOrders"
                   class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "CompletedOrders" ? "active-menu" : "")">
                    <i class="fa-solid fa-circle-check"></i> Completed Orders
                </a>
            </li>
            
        </ul>
    </div>

    <div class="content main-wrapper">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>