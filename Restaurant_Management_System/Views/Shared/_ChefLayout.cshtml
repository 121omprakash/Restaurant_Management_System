<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Chef Panel</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/chef.css" asp-append-version="true" />

</head>

<body>

    <div class="sidebar">

        <div class="chef-profile">

            <div class="profile-image">

                <i class="fa-solid fa-utensils"></i>

            </div>

            <div class="profile-details">

                <h5>Saikiran</h5>

                <p>Head Chef</p>

            </div>

        </div>

        <hr>
        <ul class="nav-menu">

            <li>
                <a asp-controller="Kitchen" asp-action="Dashboard"
                   class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active-menu" : "")">
                    <i class="fa-solid fa-house"></i>
                    Dashboard
                </a>
            </li>

            <li>
                <a asp-controller="Kitchen" asp-action="PendingOrders"
                   class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "PendingOrders" ? "active-menu" : "")">
                    <i class="fa-solid fa-clock"></i>
                    Pending Orders
                </a>
            </li>

            <li>
                <a asp-controller="Kitchen" asp-action="PreparingOrders"
                   class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "PreparingOrders" ? "active-menu" : "")">
                    <i class="fa-solid fa-fire-burner"></i>
                    Preparing Orders
                </a>
            </li>

            <li>
                <a asp-controller="Kitchen" asp-action="DelayedOrders"
                   class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "DelayedOrders" ? "active-menu" : "")">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    Delayed Orders
                </a>
            </li>

            <li>
                <a asp-controller="Kitchen" asp-action="CompletedOrders"
                   class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "CompletedOrders" ? "active-menu" : "")">
                    <i class="fa-solid fa-circle-check"></i>
                    Completed Orders
                </a>
            </li>

            

            <li class="logout">
                <a href="#">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    Logout
                </a>
            </li>

        </ul>

    </div>

    <div class="content">

        @RenderBody()

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>