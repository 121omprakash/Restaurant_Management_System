<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restaurant Management System (Chef Panel)</title>

    <script>
            (function () {
                const activeTheme = localStorage.getItem("theme") || "day";
                if (activeTheme === "dark" || activeTheme === "night") {
                    document.documentElement.classList.add("dark-theme");
                    document.documentElement.setAttribute("data-theme", "dark");
                } else {
                    document.documentElement.classList.remove("dark-theme");
                    document.documentElement.setAttribute("data-theme", "light");
                }
            })();
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet" href="~/css/chef.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <link rel="stylesheet" href="~/Restaurant_Management_System.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="master-layout">

        <header>
            <nav class="navbar navbar-expand-md custom-navbar box-shadow">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/download_logo.png" alt="Logo" />
                    </a>
                    <button class="navbar-toggler text-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarThemeCollapse" aria-controls="navbarThemeCollapse" aria-expanded="false" aria-label="Toggle navigation" style="filter: invert(1);">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarThemeCollapse">
                        <div class="d-flex align-items-center ms-auto pt-2 pt-md-0">
                            <button id="themeToggle" class="theme-toggle-btn" aria-label="Toggle System Theme">
                                <i id="themeIcon" class="fa-solid fa-moon"></i>
                                <span id="themeText">Night Mode</span>
                            </button>
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <div class="content-workspace">

            <aside class="sidebar position-relative">
                <button id="sidebarToggle" class="btn btn-link p-1 position-absolute"
                        style="top: 12px; right: 12px; color: var(--text-main); z-index: 100; text-decoration: none;">
                    <i class="fa-solid fa-bars fs-5"></i>
                </button>

                <div class="profile">
                    <div class="logo-container">
                        <i class="fa-solid fa-utensils fs-2" style="color: var(--accent-color, #f59e0b);"></i>
                    </div>
                    <h4 class="sidebar-text">John </h4>
                    <small class="sidebar-text">Head Chef</small>
                </div>

                <div class="sidebar-nav-container">
                    <ul id="chefSidebarMenu">
                        <li data-menu="Dashboard">
                            <a asp-controller="Kitchen" asp-action="Dashboard">
                                <i class="fa-solid fa-house"></i>
                                <span class="sidebar-text">Dashboard</span>
                            </a>
                        </li>
                        <li data-menu="PendingOrders">
                            <a asp-controller="Kitchen" asp-action="PendingOrders">
                                <i class="fa-solid fa-clock"></i>
                                <span class="sidebar-text">Pending Orders</span>
                            </a>
                        </li>
                        <li data-menu="PreparingOrders">
                            <a asp-controller="Kitchen" asp-action="PreparingOrders">
                                <i class="fa-solid fa-fire-burner"></i>
                                <span class="sidebar-text">Preparing Orders</span>
                            </a>
                        </li>
                        <li data-menu="DelayedOrders">
                            <a asp-controller="Kitchen" asp-action="DelayedOrders">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                <span class="sidebar-text">Delayed Orders</span>
                            </a>
                        </li>
                        <li data-menu="CompletedOrders">
                            <a asp-controller="Kitchen" asp-action="CompletedOrders">
                                <i class="fa-solid fa-circle-check"></i>
                                <span class="sidebar-text">Completed Orders</span>
                            </a>
                        </li>
                    </ul>

                    <ul>
                        <li class="logout-item" style="border-top: 1px solid var(--border-color); padding-top: 15px;">
                            <a asp-controller="Employee" asp-action="Login">
                                <i class="fa-solid fa-right-from-bracket"></i>
                                <span class="sidebar-text">Logout</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </aside>

            <div class="main-content container-fluid px-4 pt-3">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

        </div>

        <footer class="full-width-footer text-center">
            <div class="w-100">
                &copy; 2026 - RMSystem - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        // 1. Sidebar Collapse Mechanic Engine
        const toggleBtn = document.getElementById("sidebarToggle");
        const sidebar = document.querySelector(".sidebar");
        if (toggleBtn && sidebar) {
        toggleBtn.addEventListener("click", function () {
        sidebar.classList.toggle("collapsed");
        });
        }

        // 2. Dynamic Router Highlight Active Link Match Engine
        const currentPath = window.location.pathname.toLowerCase();
        const menuItems = document.querySelectorAll("#chefSidebarMenu li");

        menuItems.forEach(item => {
        const actionTarget = item.getAttribute("data-menu");
        if (actionTarget && currentPath.includes(actionTarget.toLowerCase())) {
        item.classList.add("active");
        }
        });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
