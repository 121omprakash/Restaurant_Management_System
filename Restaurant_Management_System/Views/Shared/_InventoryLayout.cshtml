<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restaurant Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Restaurant_Management_System.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Inventory.css" />
</head>

<body>

    <header>
        <div class="topbar d-flex justify-content-between align-items-center">
            <div>
                <a class="navbar-brand me-3">
                    <img src="~/download_logo.png" alt="Logo" style="height:44px;" />
                </a>
            </div>

            <div class="d-flex align-items-center">
                <button id="themeToggle" class="btn btn-outline-secondary rounded-pill" aria-label="Toggle Theme">
                    <i id="themeIcon" class="fa-solid fa-sun"></i>
                    <span id="themeText" class="ms-2">Day Mode</span>
                </button>
            </div>
        </div>
    </header>

    <div class="inventory-wrapper container-fluid px-4">
        <!-- Sidebar-->
   
        <aside class="sidebar">
            <div class="chef-profile text-center py-3">
                <div class="profile-image rounded-circle mx-auto d-flex align-items-center justify-content-center"
                     style="background-color: transparent; border: 2px solid #e0e6ed; color: ActiveText; width: 70px; height: 70px;">
                    <i class="fa-solid fa-user-tie" style="font-size: 32px;"></i>
                </div>
                <div class="profile-details mt-2">
                    <h5 class="mb-0">RestaurantMS</h5>
                    <small class="text-warning fw-medium">Inventory Clerk</small>
                </div>
            </div>

            <hr />

            <ul class="nav-menu list-unstyled ps-0">
                <li class="mb-1">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                       asp-controller="Inventory" asp-action="Dashboard">
                        <i class="fa-solid fa-house"></i> Dashboard
                    </a>
                </li>
                <li class="mb-1">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "InventoryManagement" ? "active" : "")"
                       asp-controller="Inventory" asp-action="InventoryManagement">
                        <i class="fa-solid fa-boxes-stacked"></i> Stock Management
                    </a>
                </li>
                <li class="mb-1">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")"
                       asp-controller="Inventory" asp-action="Create">
                        <i class="fa-solid fa-plus"></i> Add Item
                    </a>
                </li>
                <li class="mb-1">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "LowStock" ? "active" : "")"
                       asp-controller="Inventory" asp-action="LowStock">
                        <i class="fa-solid fa-triangle-exclamation"></i> Low Stock
                    </a>
                </li>
                <li class="logout-item mt-5">
                    <a class="nav-link" asp-controller="Employee" asp-action="Login">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </a>
                </li>
            </ul>
        </aside>
        <!-- Main content area -->
        <div class="main-content p-4">
            <div class="container">
                <div class="d-flex justify-content-end mb-3">
                    <button id="refreshBtnMain" class="btn refresh-btn rounded-pill">
                        <i class="fa-solid fa-arrow-rotate-right text-warning"></i>
                        <span class="ms-2">Refresh Hub</span>
                    </button>
                </div>

                @RenderBody()
            </div>
        </div>
    </div>

    <footer class="custom-footer text-muted">
        <div class="w-100 text-center py-2">
            &copy; 2026 - RMSystem - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        (function () {
            var themeToggle = document.getElementById('themeToggle');
            var themeIcon = document.getElementById('themeIcon');
            var themeText = document.getElementById('themeText');
            var refreshBtn = document.getElementById('refreshBtnMain');

            function applyTheme(isNight) {
                if (isNight) {
                    document.body.classList.add('night-mode');
                    themeIcon.classList.remove('fa-sun'); themeIcon.classList.add('fa-moon');
                    themeText.textContent = 'Night Mode';
                } else {
                    document.body.classList.remove('night-mode');
                    themeIcon.classList.remove('fa-moon'); themeIcon.classList.add('fa-sun');
                    themeText.textContent = 'Day Mode';
                }
            }

            try {
                var saved = localStorage.getItem('rm_theme');
                applyTheme(saved === 'night');

                themeToggle.addEventListener('click', function (e) {
                    var isNight = document.body.classList.toggle('night-mode');
                    applyTheme(isNight);
                    localStorage.setItem('rm_theme', isNight ? 'night' : 'day');
                });

                refreshBtn.addEventListener('click', function () {
                    refreshBtn.disabled = true;
                    var orig = refreshBtn.innerHTML;
                    refreshBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span class="ms-2">Refreshing...</span>';
                    // For now refresh reloads the page.
                    setTimeout(function () { location.reload(); }, 700);
                });
            } catch (ex) {
                console && console.warn && console.warn('Theme script error', ex);
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
