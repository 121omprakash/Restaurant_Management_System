<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restaurant Management System</title>

    @* Anti-Flicker: Loads before HTML body renders to apply theme *@
    <script>
            (function () {
                const activeTheme = localStorage.getItem("theme") || "day";
                if (activeTheme === "dark" || activeTheme === "night") {
                    document.documentElement.classList.add("dark-theme");
                    document.documentElement.setAttribute("data-theme", "dark");
                } else {
                    document.documentElement.classList.remove("dark-theme");
                    document.documentElement.setAttribute("data-theme", "light");
                }
            })();
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/Restaurant_Management_System.styles.css" />

    <!-- Google Font: Cinzel for Italian/Artisanal Branding -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;800&display=swap" rel="stylesheet">

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md custom-navbar box-shadow">
            <div class="container-fluid">
                <div class="navbar-brand d-flex align-items-center gap-2">
                    <img src="~/download_logo.png" style="height: 40px; width: auto;" alt="Logo" />
                    <span class="brand-title">Cheesey Corner</span>
                </div>
                <button class="navbar-toggler text-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarThemeCollapse" style="filter: invert(1);">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarThemeCollapse">
                    <div class="d-flex align-items-center ms-auto pt-2 pt-md-0">
                        <button id="themeToggle" class="theme-toggle-btn" aria-label="Toggle System Theme">
                            <i id="themeIcon" class="fa-solid fa-moon"></i>
                            <span id="themeText">Night Mode</span>
                        </button>

                        <!-- Logout Button in Top Bar -->
                        <form asp-controller="Home" asp-action="Logout" method="post" class="m-0 p-0">
                            <button class="theme-toggle-btn" type="submit">
                                <i class="fa-solid fa-right-from-bracket"></i>
                                <span>Logout</span>
                            </button>
                        </form>

                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="wrapper">
        <aside class="sidebar position-relative">
            <button id="sidebarToggle" class="btn btn-link p-1 position-absolute" style="top: 12px; right: 12px; color: var(--text-main); z-index: 100; text-decoration: none;">
                <i class="fa-solid fa-bars fs-5"></i>
            </button>

            <div class="profile">
                <div class="logo-container">
                    <img src="/AdminLogo.png" class="logo" alt="Admin Logo" onerror="this.src='https://placehold.co/80?text=RMS';" />
                </div>
                <h4 class="sidebar-text">Shaik</h4>
                <small class="sidebar-text">Administrator</small>
            </div>

            <div class="sidebar-nav-container">
                <ul id="adminSidebarMenu">
                    @if (IsSectionDefined("SidebarLinks"))
                    {
                        @RenderSection("SidebarLinks", required: false)
                    }
                    else
                    {
                        string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

                        <li data-menu="Employees">
                            <a class="nav-link @(currentAction.Equals("Employees", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                               asp-controller="Admin" asp-action="Employees">
                                <i class="fa-solid fa-users"></i>
                                <span class="sidebar-text">Employee Management</span>
                            </a>
                        </li>
                        <li data-menu="RestaurantProfile">
                            <a class="nav-link @(currentAction.Equals("RestaurantProfile", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                               asp-controller="Admin" asp-action="RestaurantProfile">
                                <i class="fa-solid fa-sliders"></i>
                                <span class="sidebar-text">Restaurant Details</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </aside>

        <div class="main-content-wrapper d-flex flex-column flex-grow-1" style="min-width: 0;">
            <main role="main" class="main-content p-4 flex-grow-1">
                @RenderBody()
            </main>
        </div>
    </div> 

    <footer class="custom-footer border-top">
        <div class="w-100 text-center py-2">
            &copy; 2026 - Cheesey Corner 
        </div>
    </footer>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js"></script>
    <script src="/js/admin-users.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <div class="toast-container position-fixed bottom-0 start-0 p-3" style="z-index: 1080;">
        @if (TempData["Message"] != null)
        {
            var displayMessage = TempData["Message"].ToString();
            var isError = displayMessage.Contains("Denied") || displayMessage.Contains("Error");

            <div id="statusToast" class="toast align-items-center border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000"
                 style="background-color: var(--bg-card); color: var(--text-main); border-left: 4px solid @(isError ? "#dc3545" : "#f59e0b") !important; border-radius: 10px;">
                <div class="d-flex py-2 px-3">
                    <div class="toast-body d-flex align-items-center gap-2">
                        <i class="fa-solid @(isError ? "fa-circle-exclamation text-danger" : "fa-circle-check text-warning") fs-5"></i>
                        <span class="fw-semibold small">@displayMessage</span>
                    </div>
                    <button type="button" class="btn-close ms-auto me-2 my-auto opacity-75" data-bs-dismiss="toast" aria-label="Close" style="filter: invert(1);"></button>
                </div>
            </div>
        }
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        var toastEl = document.getElementById('statusToast');
        if (toastEl) {
        var toast = new bootstrap.Toast(toastEl);
        toast.show();
        }
        });
    </script>
</body>
</html>