<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restaurant Management System (Admin)</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Restaurant_Management_System.styles.css" asp-append-version="true" />

    <!-- Smooth Transition style override to ensure fluid collapsing -->
    <style>
            .sidebar, .main-content {
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }
    </style>
</head>
<body>
<!--To avoid page background flicker on theme toggle-->
    <script>
            (function () {
                const activeTheme = localStorage.getItem("theme") || "day";
                if (activeTheme === "dark" || activeTheme === "night") {
                    document.documentElement.classList.add("dark-theme"); // Changed from document.body
                    document.documentElement.setAttribute("data-theme", "dark");
                } else {
                    document.documentElement.classList.remove("dark-theme"); // Changed from document.body
                    document.documentElement.setAttribute("data-theme", "light");
                }
            })();
    </script>

    <header>
        <nav class="navbar navbar-expand-md custom-navbar box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/download_logo.png" alt="Logo" />
                </a>
                <button class="navbar-toggler text-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarThemeCollapse" aria-controls="navbarThemeCollapse" aria-expanded="false" aria-label="Toggle navigation" style="filter: invert(1);">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarThemeCollapse">
                    <div class="d-flex align-items-center ms-auto pt-2 pt-md-0">
                        <button id="themeToggle" class="theme-toggle-btn" aria-label="Toggle System Theme">
                            <i id="themeIcon" class="fa-solid fa-moon"></i>
                            <span id="themeText">Night Mode</span>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="wrapper">

        <!-- UPDATE: Sidebar layout wrapper with tracking class -->
        <aside class="sidebar position-relative">

            <!-- 🛠️ ADDED: 3-Rows Burger Toggle Button placed top right -->
            <button id="sidebarToggle" class="btn btn-link p-1 position-absolute"
                    style="top: 12px; right: 12px; color: var(--text-main); z-index: 100; text-decoration: none;">
                <i class="fa-solid fa-bars fs-5"></i>
            </button>

            <!-- 1. Top Brand & Profile Section -->
            <div class="profile">
                <div class="logo-container">
                    <img src="/AdminLogo.png" class="logo" alt="Admin Logo" onerror="this.src='https://placehold.co/80?text=RMS';" />
                </div>
                <h4 class="sidebar-text">RestaurantMS</h4>
                <small class="sidebar-text">Administrator</small>
            </div>

            <!-- 2. Nav Container -->
            <div class="sidebar-nav-container">
                <!-- Main Pages -->
                <ul>
                    <li>
                        <a asp-controller="Admin" asp-action="Dashboard">
                            <i class="fa-solid fa-house"></i>
                            <span class="sidebar-text">Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Users">
                            <i class="fa-solid fa-users"></i>
                            <span class="sidebar-text">User Management</span>
                        </a>
                    </li>
                    <!-- Link to your new Settings page configuration layout view -->
                    <li>
                        <a asp-controller="Admin" asp-action="Settings">
                            <i class="fa-solid fa-sliders"></i>
                            <span class="sidebar-text">System Settings</span>
                        </a>
                    </li>
                </ul>

                <!-- Bottom Pinned Logout Option -->
                <ul>
                    <li class="logout-item" style="border-top: 1px solid var(--border-color); padding-top: 15px;">
                        <a asp-controller="User" asp-action="Login">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            <span class="sidebar-text">Logout</span>
                        </a>
                    </li>
                </ul>
            </div>
        </aside>

        <div class="main-content d-flex flex-column justify-content-between container-fluid px-4 pt-3">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>

            <footer class="custom-footer text-muted mt-auto">
                <div class="w-100 text-center py-2">
                    &copy; 2026 - RMSystem - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </footer>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- 🛠️ ADDED: Interactive Click Listener Event Hook -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
        const toggleBtn = document.getElementById("sidebarToggle");
        const sidebar = document.querySelector(".sidebar");

        if (toggleBtn && sidebar) {
        toggleBtn.addEventListener("click", function () {
        // Toggles the collapsed css architecture utility class rule wrapper
        sidebar.classList.toggle("collapsed");
        });
        }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>