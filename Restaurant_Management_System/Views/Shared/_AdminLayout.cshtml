<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restaurant Management System</title>

    @* Anti-Flicker: Loads before HTML body renders to apply theme *@
    <script>
            (function () {
                const activeTheme = localStorage.getItem("theme") || "day";
                if (activeTheme === "dark" || activeTheme === "night") {
                    document.documentElement.classList.add("dark-theme");
                    document.documentElement.setAttribute("data-theme", "dark");
                } else {
                    document.documentElement.classList.remove("dark-theme");
                    document.documentElement.setAttribute("data-theme", "light");
                }
            })();
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/Restaurant_Management_System.styles.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md custom-navbar box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="/download_logo.png" alt="Logo" />
                </a>
                <button class="navbar-toggler text-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarThemeCollapse" style="filter: invert(1);">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarThemeCollapse">
                    <div class="d-flex align-items-center ms-auto pt-2 pt-md-0">
                        <button id="themeToggle" class="theme-toggle-btn" aria-label="Toggle System Theme">
                            <i id="themeIcon" class="fa-solid fa-moon"></i>
                            <span id="themeText">Night Mode</span>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="wrapper">
        <aside class="sidebar position-relative">
            <button id="sidebarToggle" class="btn btn-link p-1 position-absolute" style="top: 12px; right: 12px; color: var(--text-main); z-index: 100; text-decoration: none;">
                <i class="fa-solid fa-bars fs-5"></i>
            </button>

            <div class="profile">
                <div class="logo-container">
                    <img src="/AdminLogo.png" class="logo" alt="Admin Logo" onerror="this.src='https://placehold.co/80?text=RMS';" />
                </div>
                <h4 class="sidebar-text">RestaurantMS</h4>
                <small class="sidebar-text">Administrator</small>
            </div>

            <div class="sidebar-nav-container">
                <ul id="adminSidebarMenu">
                    @if (IsSectionDefined("SidebarLinks"))
                    {
                        @RenderSection("SidebarLinks", required: false)
                    }
                    else
                    {
                        <li data-menu="Employees">
                            <a asp-controller="Admin" asp-action="Employees">
                                <i class="fa-solid fa-users"></i>
                                <span class="sidebar-text">Employee Management</span>
                            </a>
                        </li>
                        <li data-menu="Settings">
                            <a asp-controller="Admin" asp-action="Settings">
                                <i class="fa-solid fa-sliders"></i>
                                <span class="sidebar-text">System Settings</span>
                            </a>
                        </li>
                    }
                </ul>

                <ul>
                    <li class="logout-item" style="border-top: 1px solid var(--border-color); padding-top: 15px;">
                        <a asp-controller="Home" asp-action="Logout">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            <span class="sidebar-text">Logout</span>
                        </a>
                    </li>
                </ul>
            </div>
        </aside>

        <main role="main" class="main-content">
            @RenderBody()
        </main>
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js"></script>
    <script src="/js/admin-users.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>