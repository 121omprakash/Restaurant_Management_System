<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restaurant Management System (Admin)</title>

    <script>
            (function () {
                const activeTheme = localStorage.getItem("theme") || "day";
                if (activeTheme === "dark" || activeTheme === "night") {
                    document.documentElement.classList.add("dark-theme");
                    document.documentElement.setAttribute("data-theme", "dark");
                } else {
                    document.documentElement.classList.remove("dark-theme");
                    document.documentElement.setAttribute("data-theme", "light");
                }
            })();
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Restaurant_Management_System.styles.css" asp-append-version="true" />

    <style>
            /* 1. LAYOUT RESTRUCTURE FOR FULL-WIDTH FOOTER */
            html, body {
                height: 100%;
                margin: 0;
                overflow: hidden;
            }

            .master-layout {
                display: flex;
                flex-direction: column;
                height: 100vh;
                width: 100vw;
            }

            .content-workspace {
                display: flex;
                flex: 1;
                overflow: hidden;
            }

            /* Anti-flicker fine-tuning for layout components */
            .sidebar, .main-content {
                transition: background-color 0.08s ease-out, border-color 0.3s ease, color 0.2s ease;
            }

            .sidebar {
                width: 260px;
                height: 100%;
                overflow-y: auto;
                flex-shrink: 0;
                background-color: var(--bg-card);
                border-right: 1px solid var(--border-color);
                color: var(--text-main);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }

            .main-content {
                flex: 1;
                height: 100%;
                overflow-y: auto;
                background-color: var(--bg-primary);
            }

            .full-width-footer {
                background-color: var(--bg-card);
                border-top: 1px solid var(--border-color);
                color: var(--text-muted);
                padding: 12px 0;
                width: 100%;
                z-index: 10;
            }

            /* 2. DYNAMIC ACTIVE HIGHLIGHT THEME ENGINE */
            .sidebar-nav-container ul li a {
                display: flex;
                align-items: center;
                gap: 15px;
                text-decoration: none;
                color: var(--text-muted);
                padding: 12px 18px;
                border-radius: 12px;
                transition: all 0.2s ease;
                font-size: 15px;
            }

            /* Active highlight state following theme accent variables */
            .sidebar-nav-container ul li.active a {
                background-color: var(--accent-color, #f59e0b) !important;
                color: #1e293b !important; /* High contrast text for active state */
                font-weight: 600;
                box-shadow: 0 4px 12px rgba(245, 158, 11, 0.2);
            }

                .sidebar-nav-container ul li.active a i {
                    color: #1e293b !important;
                }

            /* Hover fallbacks for non-active links */
            .sidebar-nav-container ul li:not(.active) a:hover {
                background-color: var(--border-color);
                color: var(--text-main) !important;
            }

                .sidebar-nav-container ul li:not(.active) a:hover i {
                    color: var(--accent-color, #f59e0b) !important;
                }
    </style>
</head>
<body>
    <div class="master-layout">

        <header>
            <nav class="navbar navbar-expand-md custom-navbar box-shadow">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/download_logo.png" alt="Logo" />
                    </a>
                    <button class="navbar-toggler text-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarThemeCollapse" aria-controls="navbarThemeCollapse" aria-expanded="false" aria-label="Toggle navigation" style="filter: invert(1);">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarThemeCollapse">
                        <div class="d-flex align-items-center ms-auto pt-2 pt-md-0">
                            <button id="themeToggle" class="theme-toggle-btn" aria-label="Toggle System Theme">
                                <i id="themeIcon" class="fa-solid fa-moon"></i>
                                <span id="themeText">Night Mode</span>
                            </button>
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <div class="content-workspace">

            <aside class="sidebar position-relative">
                <button id="sidebarToggle" class="btn btn-link p-1 position-absolute"
                        style="top: 12px; right: 12px; color: var(--text-main); z-index: 100; text-decoration: none;">
                    <i class="fa-solid fa-bars fs-5"></i>
                </button>

                <div class="profile">
                    <div class="logo-container">
                        <img src="/AdminLogo.png" class="logo" alt="Admin Logo" onerror="this.src='https://placehold.co/80?text=RMS';" />
                    </div>
                    <h4 class="sidebar-text">RestaurantMS</h4>
                    <small class="sidebar-text">@(User.Identity.IsAuthenticated ? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value : "Administrator")</small>
                </div>

                <div class="sidebar-nav-container">
                    <ul id="adminSidebarMenu">
                        <li data-menu="Dashboard">
                            <a asp-controller="Admin" asp-action="Dashboard">
                                <i class="fa-solid fa-house"></i>
                                <span class="sidebar-text">Dashboard</span>
                            </a>
                        </li>

                        @if (IsSectionDefined("SidebarLinks"))
                        {
                            @RenderSection("SidebarLinks", required: false)
                        }
                        else
                        {
                            <li data-menu="Users">
                                <a asp-controller="Admin" asp-action="Users">
                                    <i class="fa-solid fa-users"></i>
                                    <span class="sidebar-text">User Management</span>
                                </a>
                            </li>
                            <li data-menu="Settings">
                                <a asp-controller="Admin" asp-action="Settings">
                                    <i class="fa-solid fa-sliders"></i>
                                    <span class="sidebar-text">System Settings</span>
                                </a>
                            </li>
                        }
                    </ul>

                    <ul>
                        <li class="logout-item" style="border-top: 1px solid var(--border-color); padding-top: 15px;">
                            <a asp-controller="User" asp-action="Login">
                                <i class="fa-solid fa-right-from-bracket"></i>
                                <span class="sidebar-text">Logout</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </aside>

            <div class="main-content container-fluid px-4 pt-3">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

        </div>

        <footer class="full-width-footer text-center">
            <div class="w-100">
                &copy; 2026 - RMSystem - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        // 1. Sidebar Toggle Mechanics
        const toggleBtn = document.getElementById("sidebarToggle");
        const sidebar = document.querySelector(".sidebar");
        if (toggleBtn && sidebar) {
        toggleBtn.addEventListener("click", function () {
        sidebar.classList.toggle("collapsed");
        });
        }

        // 2. Dynamic Auto-Highlight Link Match Engine
        const currentPath = window.location.pathname.toLowerCase();
        const menuItems = document.querySelectorAll("#adminSidebarMenu li");

        menuItems.forEach(item => {
        const actionTarget = item.getAttribute("data-menu");
        if (actionTarget && currentPath.includes(actionTarget.toLowerCase())) {
        item.classList.add("active");
        }
        });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>