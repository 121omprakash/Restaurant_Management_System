<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restaurant Management System</title>

    <!-- Google Font for Brand Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md custom-navbar box-shadow mb-3">
            <div class="container-fluid d-flex align-items-center justify-content-between">

                <!-- TOP BAR: Logo + Styled Restaurant Name -->
                <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index">
                    <img src="~/download_logo.png" style="height: 40px; width: auto; object-fit: contain;" alt="Logo" />
                    <span class="brand-title">Cheesey Corner</span>
                </a>

                <button class="navbar-toggler text-light" type="button" style="filter: invert(1);">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="d-flex align-items-center gap-2">
                    <button id="themeToggle" class="theme-toggle-btn" aria-label="Toggle System Theme">
                        <i id="themeIcon" class="fa-solid fa-moon"></i>
                        <span id="themeText">Night Mode</span>
                    </button>

                    <form asp-controller="Employee" asp-action="Login" class="m-0">
                        <button class="theme-toggle-btn" type="submit">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                </div>

            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 main-wrapper">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="custom-footer text-muted">
        <div class="w-100 text-center py-2">
            &copy; 2026 - Cheesey Corner 
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>