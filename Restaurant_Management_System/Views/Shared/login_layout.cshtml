<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restaurant Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/login_css.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Restaurant_Management_System.styles.css" asp-append-version="true" />

    <!-- Google Font: Cinzel for Italian/Artisanal Branding -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;800&display=swap" rel="stylesheet">

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md custom-navbar box-shadow mb-3">
            <div class="container-fluid">
                <div class="navbar-brand d-flex align-items-center gap-2">
                    <img src="~/download_logo.png" style="height: 40px; width: auto;" alt="Logo" />
                    <span class="brand-title">Cheesey Corner</span>
                </div>
                <button class="navbar-toggler text-light" type="button" style="filter: invert(1);">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div>
                    <div class="d-flex align-items-center ms-auto pt-2 pt-md-0">
                        <button id="themeToggle" class="theme-toggle-btn" aria-label="Toggle System Theme">
                            <i id="themeIcon" class="fa-solid fa-moon"></i>
                            <span id="themeText">Night Mode</span>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 main-wrapper">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="custom-footer text-muted">
        <div class="w-100 text-center py-2">
            &copy; 2026 - Cheesey Corner 
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>