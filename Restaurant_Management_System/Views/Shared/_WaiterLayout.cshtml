<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Waiter Panel</title>

    <script>
        (function () {
            const activeTheme = localStorage.getItem("theme") || "day";
            if (activeTheme === "dark" || activeTheme === "night") {
                document.documentElement.classList.add("dark-theme");
                document.documentElement.setAttribute("data-theme", "dark");
            } else {
                document.documentElement.classList.remove("dark-theme");
                document.documentElement.setAttribute("data-theme", "light");
            }
        })();
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/waiter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Restaurant_Management_System.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="master-layout">

        <header>
            <nav class="navbar navbar-expand-md custom-navbar box-shadow">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/download_logo.png" alt="Logo" />
                    </a>

                    <button class="navbar-toggler text-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarThemeCollapse" style="filter: invert(1);">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarThemeCollapse">
                        <div class="d-flex align-items-center ms-auto pt-2 pt-md-0 gap-2">
                            <button id="themeToggle" class="theme-toggle-btn" aria-label="Toggle System Theme">
                                <i id="themeIcon" class="fa-solid fa-moon"></i>
                                <span id="themeText">Night Mode</span>
                            </button>
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <div class="content-workspace">

            <aside class="sidebar position-relative">
                <button id="sidebarToggle" class="btn btn-link p-1 position-absolute"
                        style="top: 12px; right: 12px; color: var(--text-main); z-index: 100; text-decoration: none;">
                    <i class="fa-solid fa-bars fs-5"></i>
                </button>

                <div>
                    <!-- Updated Profile Block with Heading & Role Subtitle -->
                    <div class="profile">
                        <div class="logo-container">
                            <img src="/WaiterLogo.jpg" class="logo" alt="Waiter Profile" onerror="this.src='https://placehold.co/80?text=User';" />
                        </div>
                        <h4 class="sidebar-text">RestaurantMS</h4>
                        <small class="sidebar-text">Waiter</small>
                    </div>

                    <div class="sidebar-nav-container">
                        <ul id="waiterSidebarMenu">
                            <li data-menu="Dashboard">
                                <a href="/Waiter/Dashboard">
                                    <i class="fa-solid fa-house"></i>
                                    <span class="sidebar-text">Dashboard</span>
                                </a>
                            </li>
                            <li data-menu="TableReservation">
                                <a href="/Waiter/TableReservation">
                                    <i class="fa-solid fa-chair"></i>
                                    <span class="sidebar-text">Table Reservation</span>
                                </a>
                            </li>
                            <li data-menu="TakeOrder">
                                <a href="/Waiter/TakeOrder">
                                    <i class="fa-solid fa-chair"></i>
                                    <span class="sidebar-text">Take Order</span>
                                </a>
                            </li>
                            <li data-menu="ManageOrders">
                                <a href="/Waiter/ManageOrders">
                                    <i class="fa-solid fa-clipboard-list"></i>
                                    <span class="sidebar-text">Manage Orders</span>
                                </a>
                            </li>
                            <li data-menu="OrderStatus">
                                <a href="/Waiter/OrderStatus">
                                    <i class="fa-solid fa-truck"></i>
                                    <span class="sidebar-text">Order Status</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="sidebar-nav-container">
                    <ul>
                        <li class="logout-item" style="border-top: 1px solid var(--border-color); padding-top: 15px; margin: 6px 12px;">
                            <a asp-controller="User" asp-action="Login">
                                <i class="fa-solid fa-right-from-bracket"></i>
                                <span class="sidebar-text">Logout</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </aside>

            <div class="main-content container-fluid px-4 pt-3">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

        </div>

        <footer class="full-width-footer text-center">
            <div class="w-100 py-2">
                &copy; 2026 - RMSystem - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Sidebar Toggle Engine
            const toggleBtn = document.getElementById("sidebarToggle");
            const sidebar = document.querySelector(".sidebar");
            if (toggleBtn && sidebar) {
                toggleBtn.addEventListener("click", function () {
                    sidebar.classList.toggle("collapsed");
                });
            }

            
            const currentPath = window.location.pathname.toLowerCase();
            const menuItems = document.querySelectorAll("#waiterSidebarMenu li");

            menuItems.forEach(item => {
                const actionTarget = item.getAttribute("data-menu");
                if (actionTarget && currentPath.includes(actionTarget.toLowerCase())) {
                    item.classList.add("active");
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>