<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Waiter Panel</title>

    <link rel="stylesheet" href="~/css/Waiter.css" />

    <style>
            body {
                margin: 0;
                font-family: "Segoe UI", sans-serif;
            }

            /* ✅ NEW: PAGE STRUCTURE */
            .page {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            .layout {
                display: flex;
                flex: 1; /* ✅ takes remaining height */
            }

            /* ✅ SIDEBAR */
            .sidebar {
                width: 240px;
                background: #3c1f0f;
                color: #fff;
                display: flex;
                flex-direction: column;
                padding: 20px;
            }

            .logo {
                display: flex;
                gap: 10px;
                align-items: center;
            }

            .logo-icon {
                background: #e8611c;
                padding: 10px;
                border-radius: 50%;
                font-size: 18px;
            }

            .logo h2 {
                margin: 0;
            }

            .logo p {
                margin: 0;
                font-size: 12px;
                color: #ccc;
            }

            .user-profile {
                display: flex;
                gap: 10px;
                margin-top: 20px;
                align-items: center;
            }

            .avatar {
                width: 35px;
                height: 35px;
                border-radius: 50%;
                background: #e6ddd4;
            }

            .user-info small {
                color: #ccc;
            }

            .menu {
                list-style: none;
                padding: 0;
                margin-top: 20px;
            }

                .menu li {
                    margin-bottom: 8px;
                }

                .menu a {
                    display: block;
                    padding: 10px;
                    border-radius: 10px;
                    text-decoration: none;
                    color: #fff;
                }

                    .menu a:hover,
                    .menu a.active {
                        background: #e8611c;
                    }

            .logout {
                margin-top: auto;
                cursor: pointer;
                padding: 10px;
            }

                .logout:hover {
                    color: #e8611c;
                }

            /* ✅ MAIN CONTENT */
            .main-content {
                flex: 1;
                padding: 0;
                background: #f6f1eb;
            }

            /* ✅ FULL WIDTH FOOTER */
            .footer {
                background: #3c1f0f;
                color: white;
                text-align: center;
                padding: 10px;
            }
    </style>
</head>

<body>

    <div class="page">

        <!-- ✅ MAIN LAYOUT -->
        <div class="layout">

            <!-- SIDEBAR -->
            <aside class="sidebar">

                <div class="logo">
                    <div class="logo-icon">🍕</div>
                    <div>
                        <h2>Bella Cucina</h2>
                        <p>Waiter Console</p>
                    </div>
                </div>

                <div class="user-profile">
                    <div class="avatar"></div>
                    <div class="user-info">
                        <b>Anusha</b><br />
                        <small>Waiter - Floor 1</small>
                    </div>
                </div>

                <hr />

                <ul class="menu">
                    <li><a href="/Waiter/Dashboard">Dashboard</a></li>
                    <li><a href="/Waiter/TableReservation">Table Reservation</a></li>
                    <li><a href="/Waiter/TakeOrder">Take Order</a></li>
                    <li><a href="/Waiter/ManageOrders">Manage Orders</a></li>
                    <li><a href="/Waiter/OrderStatus">Order Status</a></li>
                </ul>

                <hr />

                <div class="logout">
                    🚪 Logout
                </div>

            </aside>

            <!-- MAIN -->
            <main class="main-content">
                @RenderBody()
            </main>

        </div>

        <!-- ✅ FULL WIDTH FOOTER -->
        <footer class="footer">
            © 2026 RMSystem
        </footer>

    </div>

</body>
</html>