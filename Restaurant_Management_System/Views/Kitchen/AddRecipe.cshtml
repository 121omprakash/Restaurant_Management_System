@model Restaurant_Management_System.Models.ViewModels.AddRecipeViewModel

@using Restaurant_Management_System.Models
@using Restaurant_Management_System.ENUM


@{
    ViewData["Title"] = "Add Recipe";
    Layout = "~/Views/Shared/_ChefLayout.cshtml";
}    
<form asp-action="AddRecipe" asp-controller="Kitchen" method="post">   
  <input asp-for="MenuItemId" type="hidden"/>
<div class="container mt-4">

    <div class="card shadow-sm">
        <div class="card-header bg-primary text   <h3 class="mb-0">@(Model.IsReadOnly ? "View Recipe" :Model.IsEdit ? "Edit Recipe" : "Add Recipe")</h3>
        </div>

        <div class="card-body">

            <div class="row mb-4">
                <div class="col-md-4">
                    <label class="fw-bold">Menu Item</label>
                    <input asp-for="ItemName" type="text" class="form-control" value="@Model.ItemName" readonly />
                </div>

                <div class="col-md-4">
                    <label class="fw-bold">Category</label>
                    <input  asp-for="Category" type="text" class="form-control" value="@Model.Category" readonly />
                </div>

                <div class="col-md-4">
                        <label class="fw-bold">Preparation Time (Minutes)</label>
                        <input asp-for="PreparationTime"
                               type="number"
                               class="form-control"
                               min="1"
                               readonly="@(Model.IsReadOnly ? "readonly" : null)" />
                        <span asp-validation-for="PreparationTime" class="text-danger"></span>
                </div>
            </div>

            <hr />

            <h4 class="mb-3">Ingredients</h4>

            <table class="table table-bordered table-hover align-middle" id="ingredientsTable">
                <thead class="table-light">
                    <tr>
                        <th style="width:40%">Ingredient</th>
                        <th style="width:20%">Quantity</th>
                        <th style="width:20%">Unit</th>
                        <th style="width:20%">Action</th>
                    </tr>
                </thead>
                    <tbody id="ingredientBody">

                        @if (Model.IsReadOnly)
                        {
                            @for (int i = 0; i < Model.IngredientNames.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input type="text"
                                               class="form-control"
                                               value="@Model.IngredientNames[i]"
                                               readonly />
                                    </td>

                                    <td>
                                        <input type="text"
                                               class="form-control"
                                               value="@Model.Quantities[i]"
                                               readonly />
                                    </td>

                                    <td>
                                        <input type="text"
                                               class="form-control"
                                               value="@Model.Units[i]"
                                               readonly />
                                    </td>

                                    <td class="text-center">
                                        -
                                    </td>
                                </tr>
                            }
                        }
                           else if (Model.IsEdit)
{
    @for (int i = 0; i < Model.IngredientIds.Count; i++)
    {
        <tr>
            <td>
                <select name="IngredientIds" class="form-select">
                    @foreach (var ingredient in ViewBag.Ingredients)
                    {
                        <option value="@ingredient.IngredientId"
                                selected="@(ingredient.IngredientId == Model.IngredientIds[i])">
                            @ingredient.IngredientName
                        </option>
                    }
                </select>
            </td>
 
            <td>
                <input type="number"
                       name="Quantities"
                       class="form-control"
                       value="@Model.Quantities[i]"
                       min="0" />
            </td>
 
            <td>
                <select name="Units" class="form-select">
                    @foreach (UnitOfMeasure unit in ViewBag.Units)
                    {
                        <option value="@unit"
                                selected="@(unit == Model.Units[i])">
                            @unit
                        </option>
                    }
                </select>
            </td>
 
            <td class="text-center">
                <button type="button" class="btn btn-danger removeIngredient">
                    Remove
                </button>
            </td>
        </tr>
    }
}
else
{
    <tr>
        <td>
            <select name="IngredientIds" class="form-select">
                <option value="">Select Ingredient</option>
 
                @foreach (var ingredient in ViewBag.Ingredients)
                {
                    <option value="@ingredient.IngredientId">
                        @ingredient.IngredientName
                    </option>
                }
            </select>
        </td>
 
        <td>
            <input type="number"
                   name="Quantities"
                   class="form-control"
                   placeholder="Enter Quantity"
                   min="0" />
        </td>
 
        <td>
            <select name="Units" class="form-select">
                @foreach (UnitOfMeasure unit in ViewBag.Units)
                {
                    <option value="@unit">@unit</option>
                }
            </select>
        </td>
 
        <td class="text-center">
            <button type="button" class="btn btn-danger removeIngredient">
                Remove
            </button>
        </td>
    </tr>
}

                    </tbody>
            </table>
                    @if (!Model.IsReadOnly)
                    {
                        <button type="button" id="addIngredientBtn" class="btn btn-success">
                            + Add Ingredient
                        </button>
                    }

            <hr class="my-4" />

            <h4 class="mb-3">Recipe Preparation Steps</h4>

             @if (!Model.IsReadOnly && System.String.IsNullOrWhiteSpace(Model.RecipeSteps))
                {
                    <button type="button"
                            id="addStepBtn"
                            class="btn btn-success">
                        + Add Steps
                    </button>
                }
             <div id="stepsContainer"
             style="display:@((!Model.IsReadOnly && !string.IsNullOrWhiteSpace(Model.RecipeSteps)) || Model.IsReadOnly ? "block" : "none")">
            

                <div class=" step mb-3">
                    <label class="form-label"><strong>Recipe Steps</strong></label>
                    <textarea asp-for="RecipeSteps"
                              class="form-control"
                              rows="8"
                              readonly="@Model.IsReadOnly"
                              placeholder="Enter preparation step..."></textarea>

                              <span asp-validation-for="RecipeSteps" class="text-danger"></span>
                              @if (!Model.IsReadOnly){
                                   <button type="button" id="removeStepBtn" class="btn btn-danger btn-sm mt-2 removeStepBtn">Remove</button>
                    }
                </div>

            </div>
                   

            <hr class="my-4" />


            <div class="d-flex justify-content-end gap-2 mt-4">
                        @if (!Model.IsReadOnly)
                        {
                            <button type="submit" class="btn btn-primary">
                    Save Recipe
                </button>
                }

                    @if (Model.IsReadOnly)
                    {
                        if (Model.ReturnTo == "OrderManagement")
                        {
                            <a asp-action="OrderManagement" class="btn btn-secondary">Back</a>
                        }
                        else
                        {
                            <a asp-action="RecipeManagement" class="btn btn-secondary">Back</a>
                        }
                    }
                    else
                    {
                        <a asp-action="RecipeManagement" class="btn btn-secondary">Cancel</a>
                    }

            </div>

        </div>
    </div>

</div>
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/kitchen.js" asp-append-version="true"></script>
}