@model Restaurant_Management_System.ViewModel.OrderManagementViewModel
@using Restaurant_Management_System.ENUM

@{
    ViewData["Title"] = "Order Management";
    Layout = "~/Views/Shared/_ChefLayout.cshtml";
}
<div class="page-header">
    <h2>Order Management</h2>
</div>
<div class="order-cards">


    <!-- Pending -->
    <div class="order-card"
         onclick="location.href='@Url.Action("OrderManagement", "Kitchen", new { status = TicketStatus.QUEUED })#ordersTable'"
    style="cursor:pointer;">
        <div class="card-content">
            <h6>PENDING ORDERS</h6>
            <h2 id="pendingCount">@Model.PendingCount</h2>
        </div>

        <div class="card-icon pending">
            <i class="fa-solid fa-clock"></i>
        </div>
    </div>

    <!-- Preparing -->
    <div class="order-card"
         onclick="location.href='@Url.Action("OrderManagement", "Kitchen", new { status = TicketStatus.IN_PROGRESS })#ordersTable'"
         style="cursor:pointer;">
        <div class="card-content">
            <h6>PREPARING ORDERS</h6>
            <h2 id="preparingCount">@Model.PreparingCount</h2>
        </div>

        <div class="card-icon preparing">
            <i class="fa-solid fa-fire-burner"></i>
        </div>
    </div>

    <!-- Completed -->
    <div class="order-card"
         onclick="location.href='@Url.Action("OrderManagement", "Kitchen", new { status = TicketStatus.READY })#ordersTable'"
         style="cursor:pointer;">
        <div class="card-content">
            <h6>COMPLETED ORDERS</h6>
            <h2 id="completedCount">@Model.CompletedCount</h2>
        </div>

        <div class="card-icon completed">
            <i class="fa-solid fa-circle-check"></i>
        </div>
    </div>

    <!-- Delayed -->
    <div class="order-card"
         onclick="location.href='@Url.Action("OrderManagement", "Kitchen", new { delayed = true })#ordersTable'"
         style="cursor:pointer;">
        <div class="card-content">
            <h6>DELAYED ORDERS</h6>
            <h2 id="delayedCount">@Model.DelayedCount</h2>
        </div>

        <div class="card-icon delayed">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
    </div>

</div>
<!-- Today's Order History -->
<!-- ========================= -->

<div   id="ordersTable" class="table-card">

    <div class="table-header">
        <h4 id="tableHeading"> Order History</h4>

            <div class="table-tools">

                <input type="text"
                       name="search"
                       
                       class="search-box"
                       placeholder="Search Order ID or Customer..." 
                       oninput="searchOrders()" />

            </div>
       
    </div>

    <table class="order-table">

        <thead>
            <tr>
                <th>Order ID</th>
                <th>Customer Name</th>
                <th>Order Type</th>
                <th>No .of Items</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            

                @if (!Model.Tickets.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center">
                            No kitchen tickets available.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var ticket in Model.Tickets)
                    {
                        <tr>
                            <td>@ticket.OrderId</td>

                            <td>@ticket.CustomerOrder.CustomerName</td>

                            <td>
                                
                                    @ticket.CustomerOrder.OrderType
                                
                            </td>

                            <td>
                               @ticket.CustomerOrder.OrderItems.Count
                            </td>

                            <td>
                            <a asp-action="ViewItems"
                               asp-controller="Kitchen"
                               asp-route-orderId="@ticket.OrderId"
                               class="action-btn view-btn">
                                <i class="fa-solid fa-eye"></i> View
                            </a>

                            @if (ticket.TicketStatus == TicketStatus.QUEUED)
                            {
                                <form asp-action="MarkItemPrepared"
                                      asp-controller="Kitchen"
                                      method="post"
                                      style="display:inline;">

                                    <input type="hidden"
                                           name="id"
                                           value="@ticket.TicketId" />

                                    <button type="submit" class="action-btn start-btn">
                                        <i class="fa-solid fa-play"></i>
                                        Start Preparing
                                    </button>

                                </form>
                            }

                            @if (ticket.TicketStatus == TicketStatus.IN_PROGRESS)
                            {
                                <form asp-action="CompleteOrder" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@ticket.TicketId" />
                                    <button type="submit" class="btn btn-success">
                                        <i class="fa-solid fa-check"></i> Complete
                                    </button>
                                </form>
                            }
                                                          
                            </td>
                        </tr>
                    }
                }

            </tbody>
        

    </table>

    <div class="pagination">
        <button>Previous</button>

        <span>1</span>

        <button>Next</button>
    </div>

</div>
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/kitchen.js" asp-append-version="true"></script>
    <script>
        (function(){
            function setHeading(text){
                var el = document.getElementById('tableHeading');
                if(el) el.textContent = text;
            }

            function mapParamsToHeading(params){
                if(params.has('delayed') && params.get('delayed') === 'true') return 'Delayed Orders';
                if(params.has('status')){
                    var s = params.get('status');
                    switch(s){
                        case 'QUEUED': return 'Pending Orders';
                        case 'IN_PROGRESS': return 'Preparing Orders';
                        case 'READY': return 'Completed Orders';
                    }
                }
                return 'Order History';
            }

            // On page load, read query params and set heading accordingly
            document.addEventListener('DOMContentLoaded', function(){
                try{
                    var params = new URLSearchParams(window.location.search);
                    var heading = mapParamsToHeading(params);
                    setHeading(heading);
                }catch(e){ /* ignore */ }

                // Also attach click handlers to update heading immediately when a card is clicked
                var cards = document.querySelectorAll('.order-card');
                cards.forEach(function(card){
                    card.addEventListener('click', function(){
                        var titleEl = card.querySelector('.card-content h6');
                        if(titleEl){
                            // Use the card title (e.g., PREPARING ORDERS) but convert to nicer form
                            var txt = titleEl.textContent || titleEl.innerText || '';
                            // Normalize common titles
                            txt = txt.trim();
                            if(/PREPARING/i.test(txt)) setHeading('Preparing Orders');
                            else if(/PENDING/i.test(txt)) setHeading('Pending Orders');
                            else if(/COMPLETED|READY/i.test(txt)) setHeading('Completed Orders');
                            else if(/DELAYED/i.test(txt)) setHeading('Delayed Orders');
                            else setHeading(txt);
                        }
                    }, {capture: true});
                });
            });
        })();
    </script>
}
