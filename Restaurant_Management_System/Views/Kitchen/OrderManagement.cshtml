@model List< Restaurant_Management_System.Models.KitchenTicket>
@using Restaurant_Management_System.ENUM

@{
    ViewData["Title"] = "Order Management";
    Layout = "~/Views/Shared/_ChefLayout.cshtml";
}
<div class="page-header">
    <h2>Order Management</h2>
</div>
<div class="order-cards">


    <!-- Pending -->
    <div class="order-card"
    onclick="location.href='@Url.Action("OrderManagement", "Kitchen", new { status = TicketStatus.QUEUED })'"
    style="cursor:pointer;">
        <div class="card-content">
            <h6>PENDING ORDERS</h6>
            <h2 id="pendingCount">@ViewBag.PendingCount</h2>
        </div>

        <div class="card-icon pending">
            <i class="fa-solid fa-clock"></i>
        </div>
    </div>

    <!-- Preparing -->
    <div class="order-card"
         onclick="location.href='@Url.Action("OrderManagement", "Kitchen", new { status = TicketStatus.IN_PROGRESS })'"
         style="cursor:pointer;">
        <div class="card-content">
            <h6>PREPARING ORDERS</h6>
            <h2 id="preparingCount">@ViewBag.PreparingCount</h2>
        </div>

        <div class="card-icon preparing">
            <i class="fa-solid fa-fire-burner"></i>
        </div>
    </div>

    <!-- Completed -->
    <div class="order-card"
         onclick="location.href='@Url.Action("OrderManagement", "Kitchen", new { status = TicketStatus.READY })'"
         style="cursor:pointer;">
        <div class="card-content">
            <h6>COMPLETED ORDERS</h6>
            <h2 id="completedCount">@ViewBag.CompletedCount</h2>
        </div>

        <div class="card-icon completed">
            <i class="fa-solid fa-circle-check"></i>
        </div>
    </div>

    <!-- Delayed -->
    <div class="order-card"
         onclick="location.href='@Url.Action("OrderManagement", "Kitchen")'"
         style="cursor:pointer;">
        <div class="card-content">
            <h6>DELAYED ORDERS</h6>
            <h2 id="delayedCount">@ViewBag.DelayedCount</h2>
        </div>

        <div class="card-icon delayed">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
    </div>

</div>
<!-- Today's Order History -->
<!-- ========================= -->

<div class="table-card">

    <div class="table-header">
        <h4> Order History</h4>
        <form asp-action="OrderManagement" asp-controller="Kitchen" method="get">
            <div class="table-tools">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="search-box"
                       placeholder="Search Order ID or Customer..." />
                <button type="submit" class="action-btn view-btn">
                    Search
                </button>
                <select name="status"
                        class="filter-box"
                        onchange="this.form.submit()">
                    

                    <option value="">All Status</option>

                    <option value="@TicketStatus.QUEUED">Pending</option>
                    <option value="@TicketStatus.IN_PROGRESS">Preparing</option>
                    <option value="@TicketStatus.READY">Completed</option>
                    <option value="Delayed">Delayed</option>

                </select>
               

            </div>
        </form>
    </div>

    <table class="order-table">

        <thead>
            <tr>
                <th>Order ID</th>
                <th>Items</th>
                <th>Status</th>
                <th>Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center">
                            No kitchen tickets available.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var ticket in Model)
                    {
                        <tr>
                            <td>@ticket.OrderId</td>

                            <td>View Items</td>

                            <td>
                                <span class="status">
                                    @ticket.TicketStatus
                                </span>
                            </td>

                            <td>
                                @(ticket.StartTime?.ToString("dd MMM yyyy"))
                            </td>

                            <td>
                            <a asp-action="ViewItems"
                               asp-controller="Kitchen"
                               asp-route-orderId="@ticket.OrderId"
                               class="action-btn view-btn">
                                <i class="fa-solid fa-eye"></i> View
                            </a>

                            @if (ticket.TicketStatus == TicketStatus.QUEUED)
                            {
                                <form asp-action="markItemPrepared"
                                      asp-controller="Kitchen"
                                      method="post"
                                      style="display:inline;">

                                    <input type="hidden"
                                           name="id"
                                           value="@ticket.TicketId" />

                                    <button type="submit" class="action-btn start-btn">
                                        <i class="fa-solid fa-play"></i>
                                        Start Preparing
                                    </button>

                                </form>
                            }

                            @if (ticket.TicketStatus == TicketStatus.IN_PROGRESS)
                            {
                                <form asp-action="completeOrder" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@ticket.TicketId" />
                                    <button type="submit" class="btn btn-success">
                                        <i class="fa-solid fa-check"></i> Complete
                                    </button>
                                </form>
                            }
                                                          
                            </td>
                        </tr>
                    }
                }

            </tbody>
        

    </table>

    <div class="pagination">
        <button>Previous</button>

        <span>1</span>

        <button>Next</button>
    </div>

</div>
 <script>
   
    function showOrders(type) {

        let orders = [];

        if (type === "pending")
            orders = pendingOrders;
        else if (type === "preparing")
            orders = preparingOrders;
        else if (type === "completed")
            orders = completedOrders;
        else
            orders = delayedOrders;

        const body = document.getElementById("orderTableBody");
        body.innerHTML = "";

        orders.forEach(order => {

            let statusClass = "";

            if (order.status === "Pending")
                statusClass = "pending";
            else if (order.status === "Preparing")
                statusClass = "preparing";
            else if (order.status === "Completed")
                statusClass = "completed";
            else
                statusClass = "delayed";

            body.innerHTML += `
            <tr>
                <td>${order.id}</td>
                <td>${order.item}</td>
                <td><span class="status ${statusClass}">${order.status}</span></td>
                <td>${order.date}</td>
                    <td>
                       
                    <div class="action-buttons">

                        <button class="action-btn view-btn">
                            <i class="fa-solid fa-eye"></i>
                            View
                        </button>

                        ${ order.status === "Pending"
                            ? `<button class="action-btn start-btn">
                                    <i class="fa-solid fa-play"></i>
                                    Start Preparing
                               </button>`

                            : order.status === "Preparing"

                            ? `<button class="action-btn complete-btn">
                                    <i class="fa-solid fa-check"></i>
                                    Complete
                               </button>`

                            : ""
                        }

                    </div>
                </td>
            </tr>`;
        });

    }

    window.onload = function () {
        showOrders("pending");
    };
</script>
