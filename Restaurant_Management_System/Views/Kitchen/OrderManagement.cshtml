@{
    ViewData["Title"] = "Order Management";
    Layout = "~/Views/Shared/_ChefLayout.cshtml";
}
<div class="page-header">
    <h2>Order Management</h2>
    <p>Monitor and manage all kitchen orders from one place</p>
</div>
<div class="order-cards">


    <!-- Pending -->
    <div class="order-card" onclick="showOrders('pending')" style="cursor:pointer;">
        <div class="card-content">
            <h6>PENDING ORDERS</h6>
            <h2 id="pendingCount">0</h2>
        </div>

        <div class="card-icon pending">
            <i class="fa-solid fa-clock"></i>
        </div>
    </div>

    <!-- Preparing -->
    <div class="order-card" onclick="showOrders('preparing')" style="cursor:pointer;">
        <div class="card-content">
            <h6>PREPARING ORDERS</h6>
            <h2 id="preparingCount">0</h2>
        </div>

        <div class="card-icon preparing">
            <i class="fa-solid fa-fire-burner"></i>
        </div>
    </div>

    <!-- Completed -->
    <div class="order-card" onclick="showOrders('completed')" style="cursor:pointer;">
        <div class="card-content">
            <h6>COMPLETED ORDERS</h6>
            <h2 id="completedCount">0</h2>
        </div>

        <div class="card-icon completed">
            <i class="fa-solid fa-circle-check"></i>
        </div>
    </div>

    <!-- Delayed -->
    <div class="order-card" onclick="showOrders('delayed')" style="cursor:pointer;">
        <div class="card-content">
            <h6>DELAYED ORDERS</h6>
            <h2 id="delayedCount">0</h2>
        </div>

        <div class="card-icon delayed">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
    </div>

</div>
<!-- Today's Order History -->
<!-- ========================= -->

<div class="table-card">

    <div class="table-header">
        <h4> Order History</h4>

        <div class="table-tools">
            <input type="text" class="search-box" placeholder="Search Order ID or Customer..." />

            <select class="filter-box">
                <option>All Status</option>
                <option>Pending</option>
                <option>Preparing</option>
                <option>Completed</option>
                <option>Delayed</option>
            </select>
        </div>
    </div>

    <table class="order-table">

        <thead>
            <tr>
                <th>Order ID</th>
                <th>Items</th>
                <th>Status</th>
                <th>Date</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody id="orderTableBody">

            <tr>
                <td>#1001</td>
                <td>Farm House Pizza</td>
                <td><span class="status pending">Pending</span></td>
                <td>@DateTime.Today.ToString("dd MMM yyyy")</td>
                <td>
                    <button class="view-btn">
                        <i class="fa-solid fa-eye"></i> View
                    </button>
                </td>
            </tr>

            <tr>
                <td>#1002</td>
              
                <td>Chicken Pizza</td>
                <td><span class="status preparing">Preparing</span></td>
                <td>@DateTime.Today.ToString("dd MMM yyyy")</td>
                <td>
                    <button class="view-btn">
                        <i class="fa-solid fa-eye"></i> View
                    </button>
                </td>
            </tr>

            <tr>
                <td>#1003</td>
                
                <td>Cheese Crust Maxx</td>
                <td><span class="status completed">Completed</span></td>
                <td>@DateTime.Today.ToString("dd MMM yyyy")</td>
                <td>
                    <button class="view-btn">
                        <i class="fa-solid fa-eye"></i> View
                    </button>
                </td>
            </tr>

        </tbody>

    </table>

    <div class="pagination">
        <button>Previous</button>

        <span>1</span>

        <button>Next</button>
    </div>

</div>
 <script>
    const pendingOrders = [
        { id: "#1001",  item: "Farm House Pizza+3 more", status: "Pending", date: "13 Jul 2026" },
        { id: "#1002",  item: "Chicken Biryani+1 more", status: "Pending", date: "13 Jul 2026" }
    ];

    const preparingOrders = [
        { id: "#1003", item: "Veg Fried Rice +4 more", status: "Preparing", date: "13 Jul 2026" }
    ];

    const completedOrders = [
        { id: "#1004",  item: "Paneer Butter Masala +4 more", status: "Completed", date: "13 Jul 2026" }
    ];

    const delayedOrders = [
        { id: "#1005",  item: "Burger Combo", status: "Delayed", date: "13 Jul 2026" }
    ];

    function showOrders(type) {

        let orders = [];

        if (type === "pending")
            orders = pendingOrders;
        else if (type === "preparing")
            orders = preparingOrders;
        else if (type === "completed")
            orders = completedOrders;
        else
            orders = delayedOrders;

        const body = document.getElementById("orderTableBody");
        body.innerHTML = "";

        orders.forEach(order => {

            let statusClass = "";

            if (order.status === "Pending")
                statusClass = "pending";
            else if (order.status === "Preparing")
                statusClass = "preparing";
            else if (order.status === "Completed")
                statusClass = "completed";
            else
                statusClass = "delayed";

            body.innerHTML += `
            <tr>
                <td>${order.id}</td>
                <td>${order.item}</td>
                <td><span class="status ${statusClass}">${order.status}</span></td>
                <td>${order.date}</td>
                    <td>
                       
                    <div class="action-buttons">

                        <button class="action-btn view-btn">
                            <i class="fa-solid fa-eye"></i>
                            View
                        </button>

                        ${ order.status === "Pending"
                            ? `<button class="action-btn start-btn">
                                    <i class="fa-solid fa-play"></i>
                                    Start Preparing
                               </button>`

                            : order.status === "Preparing"

                            ? `<button class="action-btn complete-btn">
                                    <i class="fa-solid fa-check"></i>
                                    Complete
                               </button>`

                            : ""
                        }

                    </div>
                </td>
            </tr>`;
        });

    }

    window.onload = function () {
        showOrders("pending");
    };
</script>
