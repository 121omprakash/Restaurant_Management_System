@model Restaurant_Management_System.ViewModel.RecipeManagementViewModel

@{
    ViewData["Title"] = "Recipe Management";
    Layout = "~/Views/Shared/_ChefLayout.cshtml";
}
<div class="page-header">
    <h2>Recipe Management</h2>
</div>
<div class="recipe-tabs">
    <button class="recipe-tab @(Model.ActiveTab == "existing" ? "active" : "")"
            onclick="location.href='@Url.Action("RecipeManagement", new { tab = "existing" })'">
        <i class="fa-solid fa-book-open"></i>
        Existing Recipes
    </button>

    <button class="recipe-tab @(Model.ActiveTab == "pending" ? "active" : "")"
            onclick="location.href='@Url.Action("RecipeManagement", new { tab = "pending" })'">
        <i class="fa-solid fa-clock"></i>
        Pending Recipe Requests
    </button>

</div>
<div class="recipe-table-card">
    <div class="recipe-card-header">
                      @if (Model.ActiveTab == "existing")
            {
                <h3 id="recipeTableTitle">Existing Recipes</h3>
            }
            else
            {
                <h3 id="recipeTableTitle">Pending Recipe Requests</h3>
            }
        
        </div>

        <div class="recipe-table-tools">

            <input type="text"
                   class="search-box"
                   placeholder="Search Pizza, Burger, Pasta..." />

            <select class="filter-box">
                <option>All Categories</option>
                <option>Pizza</option>
                <option>Burger</option>
                <option>Pasta</option>
                <option>Sides</option>
                <option>Beverages</option>
                <option>Desserts</option>
            </select>

        </div>

    </div>

    <div class="table-responsive">

        <table class="recipe-table">

            <colgroup>
                <col style="width:10%">
                <col style="width:28%">
                <col style="width:15%">
                <col style="width:15%">
                <col style="width:17%">
                <col style="width:15%">
            </colgroup>

            <thead>
                <tr>
                    <th>Menu ID</th>
                    <th>Menu Item</th>
                    <th>Category</th>
                    <th>Preparation Time</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ActiveTab == "existing")
                {
                    foreach (var item in Model.ExistingRecipes)
                    {
                        <tr>
                            <td>@item.MenuItemId</td>
                            <td>@item.ItemName</td>
                            <td>@item.Category</td>
                            <td>@item.PreparationTime min</td>
                            <td>
                                 <a asp-action="ViewRecipe"
                                       asp-route-menuItemId="@item.MenuItemId"
                                       class="btn  btn-info btn-sm rounded-circle" title="View">
                                       <i class="bi-eye bi-eye-fill"></i
                                     
                                    </a>
 
                                    <a asp-action="EditRecipe"
                                       asp-route-menuItemId="@item.MenuItemId"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    foreach (var item in Model.PendingRecipes)
                    {
                        <tr>
                            <td>@item.MenuItemId</td>
                            <td>@item.ItemName</td>
                            <td>@item.Category</td>
                            <td>@item.PreparationTime min</td>
                            <td>
                                <a asp-action="AddRecipe"
                                   asp-route-id="@item.MenuItemId"
                                   class="btn btn-success btn-sm">
                                    Add Recipe
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>

        </table>

    </div>

    <div class="pagination">
        <button>Previous</button>
        <span>1</span>
        <button>Next</button>
    </div>

 
</div>
