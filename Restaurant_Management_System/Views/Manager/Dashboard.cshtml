@{
    ViewData["Title"] = "Dashboard";
    Layout = "_ManagerLayout";
}

<!-- SECTION 1: TOP METRIC CARDS ROW -->
<div style="display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 30px;">

    <!-- Card 1: Orders -->
    <div style="flex: 1; min-width: 200px; background: white; padding: 20px; border-radius: 12px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between; height: 130px;">
        <div>
            <h2 style="margin: 0; font-size: 2rem; font-weight: 700; color: #0f172a;">145</h2>
            <p style="margin: 4px 0 0 0; font-size: 0.85rem; color: #64748b; font-weight: 500;">Total Orders</p>
        </div>
        <span style="font-size: 0.8rem; color: #64748b;">Today</span>
    </div>

    <!-- Card 2: Revenue -->
    <div style="flex: 1; min-width: 200px; background: white; padding: 20px; border-radius: 12px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between; height: 130px;">
        <div>
            <h2 style="margin: 0; font-size: 2rem; font-weight: 700; color: #0f172a;">₹52,000</h2>
            <p style="margin: 4px 0 0 0; font-size: 0.85rem; color: #64748b; font-weight: 500;">Revenue</p>
        </div>
        <span style="font-size: 0.8rem; color: #64748b;">Today</span>
    </div>

    <!-- Card 3: Occupied Tables -->
    <div style="flex: 1; min-width: 200px; background: white; padding: 20px; border-radius: 12px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between; height: 130px;">
        <div>
            <h2 style="margin: 0; font-size: 2rem; font-weight: 700; color: #0f172a;">18 / 25</h2>
            <p style="margin: 4px 0 0 0; font-size: 0.85rem; color: #64748b; font-weight: 500;">Occupied Tables</p>
        </div>
        <span style="font-size: 0.8rem; color: #64748b;">Today</span>
    </div>

    <!-- Card 4: Pending Orders -->
    <div style="flex: 1; min-width: 200px; background: white; padding: 20px; border-radius: 12px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between; height: 130px;">
        <div>
            <h2 style="margin: 0; font-size: 2rem; font-weight: 700; color: #ef4444;">7</h2>
            <p style="margin: 4px 0 0 0; font-size: 0.85rem; color: #64748b; font-weight: 500;">Pending Orders</p>
        </div>
        <span style="font-size: 0.8rem; color: #64748b;">Today</span>
    </div>

</div>

<!-- SECTION 2: MIDDLE ANALYTICS (SPLIT ROW) -->
<div style="display: flex; gap: 24px; flex-wrap: wrap; margin-bottom: 30px;">

    <!-- Left Column: Orders by Status Chart Block -->
    <div style="flex: 1; min-width: 320px; background: white; padding: 24px; border-radius: 12px; border: 1px solid #e2e8f0;">
        <h5 style="margin: 0 0 20px 0; font-size: 1rem; font-weight: 600; color: #1e293b;">Orders by Status</h5>
        <div style="display: flex; align-items: center; justify-content: space-around; height: 180px;">
            <!-- Mock Donut Center -->
            <div style="width: 110px; height: 110px; border-radius: 50%; border: 14px solid #3b82f6; border-top-color: #ef4444; border-right-color: #10b981; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                <span style="font-size: 0.75rem; color: #64748b; font-weight: 500;">Total</span>
                <span style="font-size: 1.1rem; font-weight: 700; color: #0f172a;">145</span>
            </div>
            <!-- Chart Legend Labels -->
            <div style="display: flex; flex-direction: column; gap: 8px; font-size: 0.85rem; color: #334155;">
                <div style="display: flex; align-items: center; gap: 30px; justify-content: space-between;">
                    <span><i class="bi bi-circle-fill" style="color: #3b82f6; font-size: 0.6rem; margin-right: 6px;"></i> Preparing</span> <strong style="color: #0f172a;">7</strong>
                </div>
                <div style="display: flex; align-items: center; gap: 30px; justify-content: space-between;">
                    <span><i class="bi bi-circle-fill" style="color: #10b981; font-size: 0.6rem; margin-right: 6px;"></i> Ready</span> <strong style="color: #0f172a;">5</strong>
                </div>
                <div style="display: flex; align-items: center; gap: 30px; justify-content: space-between;">
                    <span><i class="bi bi-circle-fill" style="color: #64748b; font-size: 0.6rem; margin-right: 6px;"></i> Served</span> <strong style="color: #0f172a;">130</strong>
                </div>
                <div style="display: flex; align-items: center; gap: 30px; justify-content: space-between;">
                    <span><i class="bi bi-circle-fill" style="color: #ef4444; font-size: 0.6rem; margin-right: 6px;"></i> Cancelled</span> <strong style="color: #0f172a;">3</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Revenue Trend Graph Block -->
    <div style="flex: 1.5; min-width: 400px; background: white; padding: 24px; border-radius: 12px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between;">
        <h5 style="margin: 0 0 10px 0; font-size: 1rem; font-weight: 600; color: #1e293b;">Revenue Trend (This Week)</h5>
        <!-- Simple mock CSS line graph shape to emulate the trend image line -->
        <div style="position: relative; height: 140px; margin-top: 20px; border-bottom: 1px solid #e2e8f0; border-left: 1px solid #e2e8f0;">
            <svg viewBox="0 0 500 100" style="width: 100%; height: 100%; overflow: visible;">
                <path d="M 0 80 Q 80 40 160 50 T 320 20 T 500 40" fill="none" stroke="#3b82f6" stroke-width="3" />
                <circle cx="160" cy="50" r="4" fill="#3b82f6" />
                <circle cx="320" cy="20" r="4" fill="#3b82f6" />
            </svg>
        </div>
        <!-- Days labels under graph -->
        <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #94a3b8; padding-top: 8px; font-weight: 500;">
            <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
        </div>
    </div>

</div>

<!-- SECTION 3: BOTTOM ALERTS PANEL -->
<div style="background: white; padding: 24px; border-radius: 12px; border: 1px solid #e2e8f0;">
    <h5 style="margin: 0 0 20px 0; font-size: 1rem; font-weight: 600; color: #1e293b;">Alerts & Notifications</h5>

    <div style="display: flex; flex-direction: column; gap: 12px;">

        <!-- Alert Item 1 -->
        <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; background-color: #fff7ed; border-radius: 8px; border: 1px solid #ffedd5;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <i class="bi bi-exclamation-triangle-fill" style="color: #f97316; font-size: 1.1rem;"></i>
                <div>
                    <span style="font-weight: 600; color: #9a3412; font-size: 0.9rem;">Low stock alert: Cheese</span>
                    <p style="margin: 2px 0 0 0; font-size: 0.8rem; color: #c2410c;">Current stock is 2 kg (Reorder level: 5 kg)</p>
                </div>
            </div>
            <button style="background: white; border: 1px solid #fed7aa; padding: 6px 14px; border-radius: 6px; font-size: 0.8rem; font-weight: 500; color: #9a3412; cursor: pointer;">View</button>
        </div>

        <!-- Alert Item 2 -->
        <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; background-color: #fef2f2; border-radius: 8px; border: 1px solid #fee2e2;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <i class="bi bi-exclamation-circle-fill" style="color: #ef4444; font-size: 1.1rem;"></i>
                <div>
                    <span style="font-weight: 600; color: #991b1b; font-size: 0.9rem;">3 Orders are delayed</span>
                    <p style="margin: 2px 0 0 0; font-size: 0.8rem; color: #b91c1c;">Orders are not yet ready from kitchen</p>
                </div>
            </div>
            <button style="background: white; border: 1px solid #fecaca; padding: 6px 14px; border-radius: 6px; font-size: 0.8rem; font-weight: 500; color: #991b1b; cursor: pointer;">View</button>
        </div>

        <!-- Alert Item 3 -->
        <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; background-color: #fff9db; border-radius: 8px; border: 1px solid #fff3bf;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <i class="bi bi-clock-fill" style="color: #f59f00; font-size: 1.1rem;"></i>
                <div>
                    <span style="font-weight: 600; color: #664d03; font-size: 0.9rem;">Table 12 is reserved in 15 mins</span>
                    <p style="margin: 2px 0 0 0; font-size: 0.8rem; color: #856404;">Time: 07:00 PM</p>
                </div>
            </div>
            <button style="background: white; border: 1px solid #ffe3e3; padding: 6px 14px; border-radius: 6px; font-size: 0.8rem; font-weight: 500; color: #664d03; cursor: pointer;">View</button>
        </div>

    </div>
</div>

 