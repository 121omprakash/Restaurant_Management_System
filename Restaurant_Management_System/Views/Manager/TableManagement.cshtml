@model Restaurant_Management_System.ViewModel.TableManagementVM

@{
	ViewData["Title"] = "Table Management";
	Layout = "_ManagerLayout";
}

<div class="menu-container">
	<div class="page-header">
		<h2>Table Management</h2>
	</div>

	<div class="card">
		<div style="margin-bottom:12px; font-weight:600;">
			<span style="color:#16a34a; margin-right:18px">● Available</span>
			<span style="color:#ef4444; margin-right:18px">● Occupied</span>
		</div>

		<div class="table-grid">
			@foreach (var t in Model.AvailableTables)
			{
				<div class="table-card available">
					<h4>@t.TableNumber</h4>
					<span class="status-text">Available</span>
				</div>
			}

			@foreach (var t in Model.OccupiedTables)
			{
				<div class="table-card occupied">
					<h4>@t.TableNumber</h4>
					<span class="status-text">Occupied</span>
				</div>
			}
		</div>
	</div>
</div>
