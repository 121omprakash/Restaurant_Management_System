@model Restaurant_Management_System.ViewModel.MenuItemCreateViewModel
@{
    ViewData["Title"] = "Add Menu Item";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="menu-container">

    <div class="page-header">
        <div>
            <h2>Add Menu Item</h2>
            <p>Add a new menu item </p>
        </div>
    </div>

    <div class="menu-form">

        <form asp-action="MenuAdd" method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label asp-for="ItemName"></label>
                <input asp-for="ItemName" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Category"></label>
                <select asp-for="Category" class="form-control">
                    @foreach (var val in Enum.GetValues(typeof(Restaurant_Management_System.ENUM.MenuCategory)))
                    {
                        <option value="@val">@val</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label asp-for="Price"></label>
                <input asp-for="Price" class="form-control" />
            </div>

            <!-- PreparationTime removed from create form per request -->

            <div class="form-group">
                <label asp-for="ItemStatus"></label>
                <select asp-for="ItemStatus" class="form-control">
                    @foreach (var val in Enum.GetValues(typeof(Restaurant_Management_System.ENUM.ItemStatus)))
                    {
                        <option value="@val">@val</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label asp-for="ImageFile">Upload Image</label>
                <input asp-for="ImageFile" type="file" class="form-control" />
            </div>

            

            <div class="button-group">
                <a asp-action="MenuManagement" class="cancel-btn">Cancel</a>
                <button type="submit" class="save-btn">Save Item</button>
            </div>
        </form>

    </div>

</div>

