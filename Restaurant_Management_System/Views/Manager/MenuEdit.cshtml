@{

    ViewData["Title"] = "Edit Menu Item (Prototype)";

    Layout = "~/Views/Shared/_ManagerLayout.cshtml";

}

<div class="menu-container">
    <div class="page-header">
        <div>
            <h2>Edit Menu Item</h2>
            <p>Update menu information (<span id="proto-subtitle">Loading Item...</span>)</p>
        </div>
    </div>
    <div class="menu-form">
        <div class="form-group">
            <label>Item Name</label>
            <input type="text" id="itemNameInput" value="" class="form-control" />
        </div>
        <div class="form-group">
            <label>Category</label>
            <select id="itemCategorySelect" class="form-select">
                <option id="cat-veg" value="Veg Pizza">Veg Pizza</option>
                <option id="cat-nonveg" value="Non-Veg Pizza">Non-Veg Pizza</option>
                <option id="cat-sides" value="Sides">Sides</option>
            </select>
        </div>
        <div class="form-group">
            <label>Price (₹)</label>
            <input type="text" id="itemPriceInput" value="" class="form-control" />
        </div>
        <div class="form-group">
            <label>Preparation Time</label>
            <input type="text" id="itemTimeInput" value="" class="form-control" />
        </div>
        <div class="form-group">
            <label>Description</label>
            <textarea id="itemDescTextarea" rows="5" class="form-control"></textarea>
        </div>
        <div class="form-group">
            <label>Status</label>
            <select class="form-select">
                <option selected>Available</option>
                <option>Unavailable</option>
            </select>
        </div>
        <div class="form-group">
            <label>Current Image</label>
            <div class="mb-2">
                <img id="itemImgPreview" src="" class="food-image" style="max-width: 200px; border-radius: 8px;" />
            </div>
        </div>
        <div class="form-group">
            <label>Change Image</label>
            <input type="file" class="form-control" />
        </div>
        <div class="button-group mt-4">
            <a asp-action="MenuManagement" class="btn btn-secondary cancel-btn">Cancel</a>
            <a asp-action="MenuManagement" class="btn btn-primary save-btn" onclick="alert('Prototype Saved Successfully!')">Update Item</a>
        </div>
    </div>
</div>

<!-- PROTOTYPE DATA ENGINE ROUTER -->
<script>

    document.addEventListener("DOMContentLoaded", function () {

        // 1. Core Mock Static Data Repository for all 8 items

        const menuItemsData = {

            "1": { name: "Farm House Pizza", category: "Veg Pizza", price: "299", time: "15 Minutes", img: "farmhouse.jpg", desc: "Fresh vegetables, mozzarella cheese, tomato sauce and herbs." },

            "2": { name: "Veggie Supreme Pizza", category: "Veg Pizza", price: "349", time: "18 Minutes", img: "veggiesupreme.jpg", desc: "Loaded with crisp bell peppers, sweet corn, black olives, onions, and extra cheese." },

            "3": { name: "Ultimate Cheese Pizza", category: "Veg Pizza", price: "399", time: "12 Minutes", img: "ultimatecheese.jpg", desc: "An indulgent blend of Mozzarella, Cheddar, Gouda, and Parmesan cheeses with classic herb sauce." },

            "4": { name: "Paneer Pizza", category: "Veg Pizza", price: "329", time: "15 Minutes", img: "paneerpizza.jpg", desc: "Spiced paneer cubes, capsicum, red paprika, and signature spicy sauce." },

            "5": { name: "Chicken Tikka Pizza", category: "Non-Veg Pizza", price: "449", time: "20 Minutes", img: "chickentikka.jpg", desc: "Tandoori chicken tikka chunks, sliced onions, mint drizzle, and mozzarella." },

            "6": { name: "BBQ Chicken Pizza", category: "Non-Veg Pizza", price: "459", time: "20 Minutes", img: "bbqchicken.jpg", desc: "Smoked grilled chicken pieces tossed in tangy BBQ sauce with red onions and cilantro." },

            "7": { name: "Fries", category: "Sides", price: "99", time: "7 Minutes", img: "fries.jpg", desc: "Golden brown, crispy crinkled potato fries lightly seasoned with sea salt." },

            "8": { name: "Pepperoni Pizza", category: "Non-Veg Pizza", price: "499", time: "15 Minutes", img: "pepperoni.jpg", desc: "Classic American favorite loaded with pork pepperoni slices and stringy mozzarella." }

        };

        // 2. Read the "?id=" value out from the browser's current URL link string

        const urlParams = new URLSearchParams(window.location.search);

        let itemId = urlParams.get('id') || "1"; // Default fallback to Farm House if link lacks parameter

        // 3. Fallback protection layer

        if (!menuItemsData[itemId]) itemId = "1";

        const selectedItem = menuItemsData[itemId];

        // 4. Inject static content straight into inputs

        document.getElementById("proto-subtitle").innerText = selectedItem.name + " Mock Profile";

        document.getElementById("itemNameInput").value = selectedItem.name;

        document.getElementById("itemPriceInput").value = selectedItem.price;

        document.getElementById("itemTimeInput").value = selectedItem.time;

        document.getElementById("itemDescTextarea").value = selectedItem.desc;

        // Dynamic image resolver path mapping

        document.getElementById("itemImgPreview").src = "/Images/" + selectedItem.img;

        // Auto-select correct category fallback dropdown options

        const catSelect = document.getElementById("itemCategorySelect");

        for (let option of catSelect.options) {

            if (option.value === selectedItem.category) {

                option.selected = true;

                break;

            }

        }

    });
</script>

 