@{
    ViewData["Title"] = "Order Monitoring";
    Layout = "_ManagerLayout";
}

<div style="background: white; padding: 24px; border-radius: 12px; border: 1px solid #e2e8f0;">
    <!-- Stage Filter Tabs Row -->
    <div style="display: flex; gap: 10px; border-bottom: 1px solid #e2e8f0; padding-bottom: 16px; margin-bottom: 24px; overflow-x: auto;">
        <button style="background: #0f172a; color: white; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 500; font-size: 0.85rem;">All (145)</button>
        <button style="background: #f1f5f9; color: #475569; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 500; font-size: 0.85rem;">Preparing (7)</button>
        <button style="background: #f1f5f9; color: #475569; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 500; font-size: 0.85rem;">Ready (5)</button>
        <button style="background: #f1f5f9; color: #475569; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 500; font-size: 0.85rem;">Served (130)</button>
    </div>

    <!-- Active Orders Data Grid -->
    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem;">
            <thead>
                <tr style="border-bottom: 2px solid #f1f5f9; color: #64748b; font-weight: 600;">
                    <th style="padding: 14px 16px;">Order ID</th>
                    <th style="padding: 14px 16px;">Customer</th>
                    <th style="padding: 14px 16px;">Table No.</th>
                    <th style="padding: 14px 16px;">Order Time</th>
                    <th style="padding: 14px 16px;">Status</th>
                    <th style="padding: 14px 16px;">Total</th>
                </tr>
            </thead>
            <tbody style="color: #334155; font-weight: 500;">
                <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 16px; font-weight: 600; color: #0f172a;">#101</td>
                    <td style="padding: 16px;">Ravi Kumar</td>
                    <td style="padding: 16px;">5</td>
                    <td style="padding: 16px; color: #64748b;">11:30 AM</td>
                    <td style="padding: 16px;"><span style="background-color: #fff7ed; color: #c2410c; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 600;">Preparing</span></td>
                    <td style="padding: 16px;">₹580</td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 16px; font-weight: 600; color: #0f172a;">#102</td>
                    <td style="padding: 16px;">Sneha Reddy</td>
                    <td style="padding: 16px;">8</td>
                    <td style="padding: 16px; color: #64748b;">11:45 AM</td>
                    <td style="padding: 16px;"><span style="background-color: #f0fdf4; color: #16a34a; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 600;">Ready</span></td>
                    <td style="padding: 16px;">₹470</td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 16px; font-weight: 600; color: #0f172a;">#103</td>
                    <td style="padding: 16px;">Amit Sharma</td>
                    <td style="padding: 16px;">2</td>
                    <td style="padding: 16px; color: #64748b;">11:50 AM</td>
                    <td style="padding: 16px;"><span style="background-color: #fff7ed; color: #c2410c; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 600;">Preparing</span></td>
                    <td style="padding: 16px;">₹1,250</td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 16px; font-weight: 600; color: #0f172a;">#104</td>
                    <td style="padding: 16px;">Pooja Patel</td>
                    <td style="padding: 16px;">12</td>
                    <td style="padding: 16px; color: #64748b;">12:05 PM</td>
                    <td style="padding: 16px;"><span style="background-color: #f0fdf4; color: #16a34a; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 600;">Ready</span></td>
                    <td style="padding: 16px;">₹320</td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 16px; font-weight: 600; color: #0f172a;">#105</td>
                    <td style="padding: 16px;">Vikram Singh</td>
                    <td style="padding: 16px;">Takeaway</td>
                    <td style="padding: 16px; color: #64748b;">12:10 PM</td>
                    <td style="padding: 16px;"><span style="background-color: #fff7ed; color: #c2410c; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 600;">Preparing</span></td>
                    <td style="padding: 16px;">₹690</td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 16px; font-weight: 600; color: #0f172a;">#106</td>
                    <td style="padding: 16px;">Anjali Desai</td>
                    <td style="padding: 16px;">4</td>
                    <td style="padding: 16px; color: #64748b;">12:15 PM</td>
                    <td style="padding: 16px;"><span style="background-color: #f1f5f9; color: #475569; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 600;">Served</span></td>
                    <td style="padding: 16px;">₹850</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

 