@model IEnumerable<Restaurant_Management_System.ViewModel.OrderMonitoringViewModel>

@{
    ViewData["Title"] = "Order Monitoring";
    Layout = "_ManagerLayout";
}

<div class="order-monitor-container">

    <div class="order-tabs">
        <button class="order-tab active">All</button>
        <button class="order-tab">Preparing</button>
        <button class="order-tab">Ready</button>
        <button class="order-tab">Served</button>
    </div>

    <div class="order-table-wrapper">
        <table class="order-table">

            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Table No.</th>
                    <th>Order Time</th>
                    <th>Status</th>
                    <th>Total</th>
                </tr>
            </thead>

            <tbody>
                <tbody>

@if (Model.Any())
{
    @foreach (var order in Model)
    {
        <tr>
            <td class="order-id">#@order.OrderId</td>
            <td>@order.CustomerName</td>
            <td>@order.TableNumber</td>

            <td class="order-time">
                @order.OrderTime.ToString("hh:mm tt")
            </td>

            <td>
                <span class="status-badge">
                    @order.OrderStatus
                </span>
            </td>

            <td>₹@order.TotalAmount</td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan="6" style="text-align:center;padding:25px;">
            No orders available.
        </td>
    </tr>
}

</tbody>
                
            </tbody>

        </table>
    </div>

</div>