@{
    ViewData["Title"] = "Reports & Billing";
    Layout = "_ManagerLayout";
}

@model Restaurant_Management_System.ViewModel.ReportsViewModel

<div class="stats-row">
    <div class="stat-card">
        <p class="muted">Today's Revenue</p>
        <h2 class="stat-value">₹@Model.TodaysRevenue.ToString("N0")</h2>
    </div>
    <div class="stat-card">
        <p class="muted">This Week</p>
        <h2 class="stat-value">₹@Model.ThisWeekRevenue.ToString("N0")</h2>
    </div>
    <div class="stat-card">
        <p class="muted">This Month</p>
        <h2 class="stat-value">₹@Model.ThisMonthRevenue.ToString("N0")</h2>
    </div>
    <div class="stat-card">
        <p class="muted">Average Bill Value</p>
        <h2 class="stat-value">₹@Model.AverageBillValue.ToString("N0")</h2>
    </div>
</div>

<div class="charts-row">
    <div class="revenue-card card">
        <h5 class="card-title">Revenue Trend</h5>
        <div class="revenue-chart">
            <svg viewBox="0 0 500 100" class="revenue-svg">
                <path d="M 0 80 Q 70 40 150 60 T 300 30 T 500 10" fill="none" stroke="#2563eb" stroke-width="3" />
                <circle cx="150" cy="60" r="4" fill="#2563eb" />
                <circle cx="300" cy="30" r="4" fill="#2563eb" />
                <circle cx="450" cy="15" r="4" fill="#2563eb" />
            </svg>
        </div>
        <div class="chart-days">
            <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
        </div>
    </div>

    <div class="card">
        <h5 class="card-title">Top Selling Items</h5>
        <div class="status-list">
            @if (Model.TopSellingItems != null && Model.TopSellingItems.Any())
            {
                foreach (var item in Model.TopSellingItems.Take(5))
                {
                    <div class="status-row">
                        <span>@item.Name</span>
                        <strong class="accent-blue">@item.Percentage% </strong>
                    </div>
                }
            }
            else
            {
                <div class="status-row"><span>No data</span></div>
            }
        </div>
    </div>
</div>

<div class="card">
    <div class="page-header">
        <h5 class="card-title">Recent Invoices</h5>
        <div>
            <button class="cancel-btn">View All Invoices</button>
        </div>
    </div>

    <div class="order-table-wrapper">
        <table class="inventory-table">
            <thead>
                <tr>
                    <th>Invoice ID</th>
                    <th>Date</th>
                    <th>Table No.</th>
                    <th>Amount</th>
                    <th>Payment Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentInvoices != null && Model.RecentInvoices.Any())
                {
                    foreach (var inv in Model.RecentInvoices)
                    {
                        var badgeClass = inv.PaymentStatus?.ToUpper() == "PAID" ? "badge-paid" : (inv.PaymentStatus?.ToUpper() == "REFUNDED" ? "badge-refunded" : "badge-pending");
                        <tr>
                        <td class="font-weight-600">
                            <a asp-controller="Billing" asp-action="Invoice" asp-route-invoiceId="@inv.InvoiceId">@inv.InvoiceLabel</a>
                        </td>
                            <td>@inv.Date.ToString("dd MMM yyyy")</td>
                            <td>@inv.TableNumber</td>
                            <td>₹@inv.Amount.ToString("N0")</td>
                            <td><span class="badge @badgeClass">@inv.PaymentStatus</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5">No invoices found</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
