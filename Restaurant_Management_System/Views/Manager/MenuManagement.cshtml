@model IEnumerable<Restaurant_Management_System.Models.MenuItem>
@using Restaurant_Management_System.ENUM

@{
    ViewData["Title"] = "Menu Management";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<style>
    .menu-item-icon {
        width: 40px;
        height: 40px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
    }
</style>

<div class="menu-container">

    <div class="page-header">
        <div>
            <h2>Menu Management</h2>
            <p>Manage restaurant menu items.</p>
        </div>

        <a asp-action="MenuAdd" asp-controller="Manager" class="add-btn">
            + Add Item
        </a>
    </div>

    <div class="filter-section">
        <input type="text"
               id="menuSearchInput"
               class="search-box"
               placeholder="Search menu item..." />

        <select id="categoryFilter" class="category-dropdown">
            <option value="">All Categories</option>
            @foreach (var category in Enum.GetValues(typeof(MenuCategory)))
            {
                <option value="@category">@category</option>
            }
        </select>
    </div>

    <table class="menu-table" id="menuTable">
        <thead>
            <tr>
                <th>Image</th>
                <th>Item Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    var statusCss = item.ItemStatus == ItemStatus.AVAILABLE ? "available" : "unavailable";
                    var displayImage = !string.IsNullOrEmpty(item.ImagePath) 
                                       ? item.ImagePath 
                                       : Url.Content("~/images/default-food.png");

                    <tr data-category="@item.Category">
                        <td>
                            <img src="@displayImage" alt="@item.ItemName" class="menu-item-icon" />
                        </td>
                        <td class="item-name"><strong>@item.ItemName</strong></td>
                        <td>@item.Category</td>
                        <td>₹@item.Price.ToString("F2")</td>
                        <td>
                            <span class="status @statusCss">@item.ItemStatus</span>
                        </td>
                        <td>
                            <a asp-action="MenuView" asp-route-id="@item.MenuItemId" class="view-btn">View</a>
                            <a asp-action="MenuEdit" asp-route-id="@item.MenuItemId" class="edit-btn">Edit</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr id="noResultsRow">
                    <td colspan="6" style="text-align: center; padding: 30px; color: #64748b;">
                        No menu items found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('menuSearchInput');
        const categoryFilter = document.getElementById('categoryFilter');

        function filterMenu() {
            const searchTerm = searchInput.value.toLowerCase().trim();
            const selectedCategory = categoryFilter.value.toLowerCase().trim();
            const rows = document.querySelectorAll('#menuTable tbody tr');

            rows.forEach(row => {
                if (row.id === 'noResultsRow') return;

                const nameText = (row.querySelector('.item-name')?.textContent || '').toLowerCase();
                const rowCategory = (row.getAttribute('data-category') || '').toLowerCase();

                const matchesSearch = nameText.includes(searchTerm);
                const matchesCategory = !selectedCategory || rowCategory === selectedCategory;

                if (matchesSearch && matchesCategory) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        searchInput.addEventListener('keyup', filterMenu);
        categoryFilter.addEventListener('change', filterMenu);
    </script>
}