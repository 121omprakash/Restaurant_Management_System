@model IEnumerable<Restaurant_Management_System.Models.MenuItem>

@{
    ViewData["Title"] = "Menu Management";
    Layout = "_ManagerLayout";
}

<div class="menu-container">
    <div class="page-header">
        <div>
            <h2>Menu Management</h2>
            <p>Manage restaurant menu items.</p>
        </div>
        <a asp-controller="Manager" asp-action="MenuAdd" class="add-btn">
            <i class="fa-solid fa-plus"></i> Add Item
        </a>
    </div>

    <!-- Filters & Search Toolbar -->
    <div class="filter-section">
        <input type="text" id="menuSearch" class="search-box" placeholder="Search menu item..." onkeyup="filterMenuTable()" />

        <select id="categoryFilter" class="category-dropdown" onchange="filterMenuTable()">
            <option value="">All Categories</option>
            <option value="Veg Pizza">Veg Pizza</option>
            <option value="Non-Veg Pizza">Non-Veg Pizza</option>
        </select>
    </div>

    <!-- Menu Table -->
    <div class="order-table-wrapper">
        <table class="menu-table" id="menuTable">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Item Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var isAvailable = item.ItemStatus == Restaurant_Management_System.ENUM.ItemStatus.AVAILABLE;

                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(item.ImagePath) ? "/images/default-pizza.png" : item.ImagePath)"
                                     alt="@item.ItemName"
                                     class="food-img" />
                            </td>
                            <td><strong>@item.ItemName</strong></td>
                            <td>@item.Category</td>
                            <td>₹@item.Price.ToString("F0")</td>
                            <td>
                                <!-- Status Toggle Form -->
                                <form asp-controller="Manager" asp-action="ToggleStatus" asp-route-id="@item.MenuItemId" method="post" class="status-toggle-form">
                                    <label class="status-toggle-wrapper">
                                        <input type="checkbox"
                                               class="status-toggle-checkbox"
                                        @(isAvailable ? "checked" : "")
                                               onchange="this.form.submit()">
                                        <span class="status-pill @(isAvailable ? "available" : "status-out")">
                                            @(isAvailable ? "Available" : "Unavailable")
                                        </span>
                                    </label>
                                </form>
                            </td>
                            <td>
                                <a asp-controller="Manager" asp-action="MenuEdit" asp-route-id="@item.MenuItemId" class="view-btn" title="View Details">
                                    View
                                </a>
                                <a asp-controller="Manager" asp-action="MenuEdit" asp-route-id="@item.MenuItemId" class="edit-btn" title="Edit Item">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align:center; padding: 30px;">
                            No items found. Click "+ Add Item" to create one.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function filterMenuTable() {
            const searchInput = document.getElementById('menuSearch').value.trim().toLowerCase();
            const categoryFilter = document.getElementById('categoryFilter').value.trim().toLowerCase();
            const tableRows = document.querySelectorAll('#menuTable tbody tr');

            tableRows.forEach(row => {
                if (row.children.length < 3) return;

                const nameText = row.children[1].textContent.trim().toLowerCase();
                const categoryText = row.children[2].textContent.trim().toLowerCase();

                const matchesSearch = nameText.includes(searchInput);
                const matchesCategory = categoryFilter === '' || categoryText === categoryFilter;

                if (matchesSearch && matchesCategory) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    </script>
}