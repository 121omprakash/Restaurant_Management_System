    @{
        ViewData["Title"] = "Restaurant Management System";
    
        Layout = "~/Views/Shared/login_layout.cshtml";
    }
    @model Restaurant_Management_System.ViewModel.LoginViewModel;

    <div class="row justify-content-center align-items-center" style="min-height: 75vh;">
        <div class="col-12 col-sm-10 col-md-6 col-lg-4">

            <div class="card border-0">
                <div class="card-body p-4 p-sm-5">

                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle p-3 mb-2" style="width: 60px; height: 60px;">
                            <i class="fa-solid fa-user-tie fa-xl"></i>
                        </div>
                        <h2 class="fw-bold m-0" style="color: var(--text-main); font-size: 1.75rem;">Employee Login</h2>
                        <p class="small text-muted mt-1">Access the operational terminal</p>
                    </div>

                    <form asp-action="Login" asp-controller="Employee" method="post">

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger bg-danger bg-opacity-10 border-0 text-danger small mb-3 text-center" role="alert">
                                <i class="fa-solid fa-circle-exclamation me-1"></i> @ViewBag.Error
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Employee Id:</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fa-solid fa-id-card"></i>
                                </span>
                                <input class="form-control" type="text" required placeholder="Enter your emp id" asp-for="UserId" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-semibold text-muted">Password</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fa-solid fa-key"></i>
                                </span>
                                <input class="form-control" type="password" placeholder="Enter your password" asp-for="password" required />
                            </div>
                        </div>

                        <button class="btn btn-warning w-100 fw-bold py-2 mb-2 shadow-sm" type="submit">
                            <i class="fa-solid fa-right-to-bracket me-2"></i> Log In
                        </button>

                    </form>

                </div>
            </div>

        </div>
    </div>