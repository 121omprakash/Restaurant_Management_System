@model Restaurant_Management_System.ViewModel.AdminDashboardViewModel

@{
    ViewData["Title"] = "Employee Management";
    Layout = "_AdminLayout";

    // Data Definition: Valid local system role descriptors
    var availableRoles = new[] { "Admin", "Chef", "Manager", "Waiter", "Cashier", "Inventory Clerk" };
}

<!-- Content Header: Section Title and Primary Call-to-Action Add-Button Panel -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="page-title mb-1" style="font-size: 1.6rem;">Welcome back, Admin</h3>
        <p class="page-subtitle small mb-0">Create, control, and configure staff accounts and role access models.</p>
    </div>
    <button class="btn btn-warning text-dark fw-bold px-4 py-2 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#addUserModal">
        <i class="fa-solid fa-user-plus me-2"></i> Add Employee
    </button>
</div>

<!-- Grid Matrix Component: Quick Statistics & Analytics Dashboard Layout -->
<div class="row g-3 mb-4">
    <!-- Quick Stat: Overall Registered Profile Counts -->
    <div class="col-md-4">
        <div class="card p-3 border border-secondary shadow-sm h-100" style="background-color: var(--bg-card); border-radius: 12px;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-uppercase fw-bold d-block mb-1" style="font-size:0.75rem; letter-spacing:0.5px; color:var(--text-main); opacity:.7;">
                        Total Employees
                    </span>

                    <div class="d-flex align-items-baseline gap-2">
                        <h3 class="mb-0 fw-bold" style="font-size:1.75rem; color:var(--text-main);">
                            @Model.TotalProfiles
                        </h3>

                        <div class="d-flex gap-2 ms-2">
                            <small class="fw-semibold px-2 py-1 rounded bg-success bg-opacity-10 text-success" style="font-size:.75rem;">
                                <i class="fa-solid fa-circle-check me-1"></i>
                                @Model.ActiveProfiles Active
                            </small>

                            <small class="fw-semibold px-2 py-1 rounded bg-danger bg-opacity-10 text-danger" style="font-size:.75rem;">
                                <i class="fa-solid fa-circle-xmark me-1"></i>
                                @Model.InactiveProfiles Inactive
                            </small>
                        </div>
                    </div>
                </div>

                <div class="rounded-3 d-flex align-items-center justify-content-center" style="width:46px; height:46px; background-color:rgba(245,158,11,.15); color:#d97706;">
                    <i class="fa-solid fa-users fs-5"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stat: Admin and Manager Counts -->
    <div class="col-md-4">
        <div class="card p-3 border border-secondary shadow-sm h-100" style="background-color: var(--bg-card); border-radius: 12px;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-uppercase fw-bold d-block mb-1" style="font-size:0.75rem; letter-spacing:0.5px; color:var(--text-main); opacity:.7;">
                        Management Staff
                    </span>

                    <div class="d-flex align-items-baseline gap-2">
                        <h3 class="mb-0 fw-bold" style="font-size:1.75rem; color:var(--text-main);">
                            @Model.ManagementStaff
                        </h3>

                        <small style="font-size:.75rem; color:var(--text-main); opacity:.7;">
                            Admin &amp; Managers
                        </small>
                    </div>
                </div>

                <div class="rounded-3 d-flex align-items-center justify-content-center" style="width:46px; height:46px; background-color:rgba(59,130,246,.15); color:#2563eb;">
                    <i class="fa-solid fa-user-tie fs-5"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stat: Active Floor, Serving, and Production Kitchen Staff Counts -->
    <div class="col-md-4">
        <div class="card p-3 border border-secondary shadow-sm h-100" style="background-color: var(--bg-card); border-radius: 12px;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-uppercase fw-bold d-block mb-1" style="font-size:0.75rem; letter-spacing:0.5px; color:var(--text-main); opacity:.7;">
                        Operational Staff
                    </span>

                    <div class="d-flex align-items-baseline gap-2">
                        <h3 class="mb-0 fw-bold" style="font-size:1.75rem; color:var(--text-main);">
                            @Model.OperationalStaff
                        </h3>

                        <small style="font-size:.75rem; color:var(--text-main); opacity:.7;">
                            Floor and Kitchen Staff
                        </small>
                    </div>
                </div>

                <div class="rounded-3 d-flex align-items-center justify-content-center" style="width:46px; height:46px; background-color:rgba(16,185,129,.15); color:#059669;">
                    <i class="fa-solid fa-utensils fs-5"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Control Panel Card: Holds search tools, filters, and employee list data table -->
<div class="card p-4 border border-secondary shadow-sm" style="background-color: var(--bg-card); border-radius: 16px;">
    <div class="mb-4">
        <h4 class="h5 mb-0 fw-bold">Staff Members</h4>
    </div>

    <!-- Filter Control Row: Integrates search inputs with role-filtering action dropdowns -->
    <div class="d-flex flex-md-row flex-column justify-content-between align-items-md-center gap-3 mb-4">
        <div class="search-box position-relative" style="max-width: 320px; width: 100%;">
            <input type="text" id="userSearch" class="form-control bg-transparent border-secondary ps-5 rounded-pill py-2" placeholder="Search by name or ID..." />
            <i class="fa-solid fa-magnifying-glass position-absolute start-0 top-50 translate-middle-y ms-3 text-muted"></i>
        </div>

        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle rounded-pill px-3 py-2 border-secondary" type="button" id="roleFilterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-filter me-2"></i> Filter by Role
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="roleFilterDropdown" style="background-color: var(--bg-card); border: 1px solid var(--border-color);">
                <li><a class="dropdown-item filter-role-opt text-body" href="#" data-role="all">All Employees</a></li>
                <li><a class="dropdown-item filter-role-opt text-body" href="#" data-role="status-active">Status: Active Only</a></li>
                <li><a class="dropdown-item filter-role-opt text-body" href="#" data-role="status-inactive">Status: Inactive Only</a></li>
                <li><hr class="dropdown-divider border-secondary"></li>
                @foreach (var role in availableRoles)
                {
                    <li><a class="dropdown-item filter-role-opt text-body" href="#" data-role="@role">@role</a></li>
                }
            </ul>
        </div>
    </div>

    <!-- Data Presentation Container: Tabular list execution grid -->
    <div class="table-responsive">
        <table class="table align-middle text-nowrap table-hover table-bordered border-secondary mb-0">
            <thead>
                <tr class="text-muted">
                    <th class="ps-3 text-uppercase tracking-wider fw-bold">Employee Name</th>
                    <th class="text-uppercase tracking-wider fw-bold">Employee ID</th>
                    <th class="text-uppercase tracking-wider fw-bold">Role Designation</th>
                    <th class="text-uppercase tracking-wider fw-bold">Active Status</th>
                    <th class="text-end pe-3 text-uppercase tracking-wider fw-bold">Actions</th>
                </tr>
            </thead>
            <tbody id="userTableBody">
                @foreach (var emp in Model.Employees)
                {
                    <tr style="@(!emp.IsActive ? "opacity: 0.55;" : "")">
                        <td class="ps-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar-circle">
                                    @emp.Name.Substring(0, 1).ToUpper()
                                </div>
                                <span class="fw-semibold">@emp.Name</span>
                            </div>
                        </td>
                        <td>
                            <span class="emp-id-badge">@emp.EmpId</span>
                        </td>
                        <td>
                            <span class="fw-semibold">@emp.Role</span>
                        </td>
                        <td>
                            @if (emp.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-20 px-2 py-1">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-20 px-2 py-1">Deactivated</span>
                            }
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group">
                                @if (emp.Role == "Admin")
                                {
                                    <button class="btn btn-sm btn-outline-info rounded-start px-3" disabled title="Admin Account cannot be edited">
                                        <i class="fa-solid fa-lock"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-warning rounded-start px-3"
                                            data-bs-toggle="modal" data-bs-target="#editUserModal"
                                            data-id="@emp.Id" data-userid="@emp.EmpId" data-name="@emp.Name" data-role="@emp.Role" data-active="@emp.IsActive.ToString().ToLower()" title="Edit Account">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-end px-3"
                                            data-bs-toggle="modal" data-bs-target="#deleteConfirmModal"
                                            data-id="@emp.Id" data-name="@emp.Name" data-active="@emp.IsActive.ToString().ToLower()" title="Toggle Account Status">
                                        <i class="fa-solid fa-user-slash"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL POPUP WINDOW 1: ADD NEW EMPLOYEE SYSTEM PROFILE FORM -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border border-secondary" style="background-color: var(--bg-card); border-radius: 16px;">
            <div class="modal-header border-bottom border-secondary px-4">
                <h5 class="modal-title">Create Staff Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateEmployee" asp-controller="Admin" method="POST">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small text-muted">Full Name</label>
                        <input type="text" name="name" class="form-control bg-transparent border-secondary rounded-3 py-2" autocomplete="off" required placeholder="Ex: John Doe" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Password</label>
                        <input type="password" name="password" class="form-control bg-transparent border-secondary rounded-3 py-2" autocomplete="new-password" required placeholder="••••••••" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label small text-muted">Authorized System Role</label>
                        <select name="role" class="form-select bg-transparent border-secondary rounded-3 py-2" required>
                            @foreach (var role in availableRoles)
                            {
                                if (role != "Admin")
                                {
                                    <option value="@role">@role</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top border-secondary px-4">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-3" data-bs-dismiss="modal">Discard</button>
                    <button type="submit" class="btn btn-sm btn-warning text-dark fw-bold px-4 py-2 rounded-3">Save Employee</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL POPUP WINDOW 2: EDIT EXISTING EMPLOYEE DETAILS ACTION FORM -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border border-secondary" style="background-color: var(--bg-card); border-radius: 16px;">
            <div class="modal-header border-bottom border-secondary px-4">
                <h5 class="modal-title">Modify Staff Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateEmployee" asp-controller="Admin" method="POST">
                <input type="hidden" name="id" id="edit_Id" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small text-muted">Employee ID</label>
                        <input type="text" id="edit_UserId" class="form-control rounded-3 py-2 opacity-75 bg-body-secondary text-muted" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Full Name</label>
                        <input type="text" name="name" id="edit_Name" class="form-control bg-transparent border-secondary rounded-3 py-2" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">New Password (leave blank to keep unchanged)</label>
                        <input type="password" name="password" id="edit_Password" class="form-control bg-transparent border-secondary rounded-3 py-2" placeholder="••••••••" autocomplete="new-password" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label small text-muted">Authorized System Role</label>
                        <select name="role" id="edit_Role" class="form-select bg-transparent border-secondary rounded-3 py-2">
                            @foreach (var role in availableRoles)
                            {
                                if (role != "Admin")
                                {
                                    <option value="@role">@role</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top border-secondary px-4">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-3" data-bs-dismiss="modal">Discard</button>
                    <button type="submit" class="btn btn-sm btn-warning text-dark fw-bold px-4 py-2 rounded-3">Update Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL POPUP WINDOW 3: SUSPEND ACCESSIBILITY TERMINAL (CONFIRMATION WARNING PANEL) -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border border-danger shadow-lg" style="background-color: var(--bg-card); border-radius: 14px;">
            <div class="modal-body text-center p-4">
                <div class="text-danger mb-3" style="font-size: 2.5rem;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h6 class="mb-1 fw-bold" style="color: var(--text-main);">Disable Profile Access?</h6>
                <p class="small mb-4" id="deleteModalMessage" style="color: var(--text-main); opacity: 0.7;">Are you sure you want to deactivate this staff user account profile?</p>
                <form asp-action="ToggleStatus" asp-controller="Admin" method="POST">
                    <input type="hidden" name="id" id="delete_Id" />
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-3 flex-grow-1" style="color: var(--text-main);" data-bs-dismiss="modal">No</button>
                        <button type="submit" class="btn btn-sm btn-danger fw-bold px-3 py-2 rounded-3 flex-grow-1">Yes, Deactivate</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/admin-users.js" asp-append-version="true"></script>
}