@{
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="page-title mb-1" style="font-size: 1.6rem; color: var(--text-main);">Employee Management</h3>
        <p class="page-subtitle small mb-0" style="font-size: 0.85rem; color: var(--text-muted);">Create and manage staff accounts and role assignments.</p>
    </div>
    <button class="btn btn-warning text-dark fw-bold px-4 py-2 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#addUserModal">
        <i class="fa-solid fa-user-plus me-2"></i> Add Employee
    </button>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 border border-secondary shadow-sm h-100" style="background-color: var(--bg-card); border-radius: 12px;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-uppercase fw-bold d-block mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px; color: var(--text-muted);">Total Profiles</span>
                    <div class="d-flex align-items-baseline gap-2">
                        <h3 class="mb-0 fw-bold" style="color: var(--text-main); font-size: 1.75rem;">3</h3>
                        <small class="fw-semibold" style="font-size: 0.8rem; color: #10b981;"><i class="fa-solid fa-circle-check me-1"></i>Active</small>
                    </div>
                </div>
                <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; background-color: rgba(245, 158, 11, 0.15); color: #d97706;">
                    <i class="fa-solid fa-users fs-5"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3 border border-secondary shadow-sm h-100" style="background-color: var(--bg-card); border-radius: 12px;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-uppercase fw-bold d-block mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px; color: var(--text-muted);">Security Admins</span>
                    <div class="d-flex align-items-baseline gap-2">
                        <h3 class="mb-0 fw-bold" style="color: var(--text-main); font-size: 1.75rem;">1</h3>
                        <small style="font-size: 0.75rem; color: var(--text-muted);">Full Control</small>
                    </div>
                </div>
                <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; background-color: rgba(59, 130, 246, 0.15); color: #2563eb;">
                    <i class="fa-solid fa-user-shield fs-5"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3 border border-secondary shadow-sm h-100" style="background-color: var(--bg-card); border-radius: 12px;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-uppercase fw-bold d-block mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px; color: var(--text-muted);">Operational Staff</span>
                    <div class="d-flex align-items-baseline gap-2">
                        <h3 class="mb-0 fw-bold" style="color: var(--text-main); font-size: 1.75rem;">2</h3>
                        <small style="font-size: 0.75rem; color: var(--text-muted);">Floor/Kitchen</small>
                    </div>
                </div>
                <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; background-color: rgba(16, 185, 129, 0.15); color: #059669;">
                    <i class="fa-solid fa-utensils fs-5"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card p-4 border border-secondary shadow-sm" style="background-color: var(--bg-card); border-radius: 16px;">
    <div class="mb-4">
        <h4 class="h5 mb-0 fw-bold" style="color: var(--text-main);">Staff Members</h4>
    </div>

    <div class="d-flex flex-md-row flex-column justify-content-between align-items-md-center gap-3 mb-4">
        <div class="search-box position-relative" style="max-width: 320px; width: 100%;">
            <input type="text" id="userSearch" class="form-control bg-transparent border-secondary ps-5 rounded-pill py-2" style="color: var(--text-main);" placeholder="Search by name or ID..." />
            <i class="fa-solid fa-magnifying-glass position-absolute start-0 top-50 translate-middle-y ms-3 text-muted"></i>
        </div>

        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle rounded-pill px-3 py-2 border-secondary" style="color: var(--text-main);" type="button" id="roleFilterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-filter me-2"></i> Filter by Role
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="roleFilterDropdown" style="background-color: var(--bg-card); border: 1px solid var(--border-color);">
                <li><a class="dropdown-item filter-role-opt text-secondary" href="#" data-role="all">All Roles</a></li>
                <li><hr class="dropdown-divider border-secondary"></li>
                <li><a class="dropdown-item filter-role-opt text-secondary" href="#" data-role="Admin">Administrator</a></li>
                <li><a class="dropdown-item filter-role-opt text-secondary" href="#" data-role="Manager">Manager</a></li>
                <li><a class="dropdown-item filter-role-opt text-secondary" href="#" data-role="Chef">Chef</a></li>
                <li><a class="dropdown-item filter-role-opt text-secondary" href="#" data-role="Waiter">Waiter</a></li>
                <li><a class="dropdown-item filter-role-opt text-secondary" href="#" data-role="Cashier">Cashier</a></li>
                <li><a class="dropdown-item filter-role-opt text-secondary" href="#" data-role="Inventory Clerk">Inventory Clerk</a></li>
            </ul>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle text-nowrap table-hover table-bordered border-secondary mb-0" style="color: var(--text-main);">
            <thead>
                <tr style="color: var(--text-muted);">
                    <th class="ps-3 text-uppercase tracking-wider fw-bold" style="font-size: 0.82rem; letter-spacing: 0.5px;">Employee Name</th>
                    <th class="text-uppercase tracking-wider fw-bold" style="font-size: 0.82rem; letter-spacing: 0.5px;">Employee ID</th>
                    <th class="text-uppercase tracking-wider fw-bold" style="font-size: 0.82rem; letter-spacing: 0.5px;">Role Designation</th>
                    <th class="text-end pe-3 text-uppercase tracking-wider fw-bold" style="font-size: 0.82rem; letter-spacing: 0.5px;">Actions</th>
                </tr>
            </thead>
            <tbody id="userTableBody">
                <tr>
                    <td class="ps-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="avatar-circle" style="width:32px; height:32px; background:#f59e0b; color:#1e293b; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:bold; font-size: 0.85rem;">A</div>
                            <div>
                                <span class="d-block" style="font-size: 0.95rem; font-weight: 500; color: var(--text-main);">Asiya</span>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="emp-id-badge" style="font-size: 0.95rem; color: var(--text-main);">EMP-1001</span>
                    </td>
                    <td>
                        <span class="badge px-2.5 py-1.5" style="font-size: 0.78rem;">Admin</span>
                    </td>
                    <td class="text-end pe-3">
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-outline-warning rounded-start px-3" data-bs-toggle="modal" data-bs-target="#editUserModal" data-id="1" data-userid="EMP-1001" data-name="Asiya Shaik" data-role="Admin" title="Edit Account">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-end px-3" data-bs-toggle="modal" data-bs-target="#deleteConfirmModal" data-id="1" data-name="Asiya Shaik" title="Delete Account">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td class="ps-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="avatar-circle" style="width:32px; height:32px; background:#10b981; color:#ffffff; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:bold; font-size: 0.85rem;">S</div>
                            <div>
                                <span class="d-block" style="font-size: 0.95rem; font-weight: 500; color: var(--text-main);">Sana</span>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="emp-id-badge" style="font-size: 0.95rem; color: var(--text-main);">EMP-1002</span>
                    </td>
                    <td>
                        <span class="badge px-2.5 py-1.5" style="font-size: 0.78rem;">Chef</span>
                    </td>
                    <td class="text-end pe-3">
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-outline-warning rounded-start px-3" data-bs-toggle="modal" data-bs-target="#editUserModal" data-id="2" data-userid="EMP-1002" data-name="Sana" data-role="Chef" title="Edit Account">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-end px-3" data-bs-toggle="modal" data-bs-target="#deleteConfirmModal" data-id="2" data-name="Sana" title="Delete Account">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td class="ps-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="avatar-circle" style="width:32px; height:32px; background:#f59e0b; color:#1e293b; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:bold; font-size: 0.85rem;">M</div>
                            <div>
                                <span class="d-block" style="font-size: 0.95rem; font-weight: 500; color: var(--text-main);">Mehreen</span>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="emp-id-badge" style="font-size: 0.95rem; color: var(--text-main);">EMP-1006</span>
                    </td>
                    <td>
                        <span class="badge px-2.5 py-1.5" style="font-size: 0.78rem;">Cashier</span>
                    </td>
                    <td class="text-end pe-3">
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-outline-warning rounded-start px-3" data-bs-toggle="modal" data-bs-target="#editUserModal" data-id="3" data-userid="EMP-1006" data-name="Mehreen" data-role="Mehreen" title="Edit Account">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-end px-3" data-bs-toggle="modal" data-bs-target="#deleteConfirmModal" data-id="3" data-name="Mehreen" title="Delete Account">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </td>
                </tr>


            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border border-secondary" style="background-color: var(--bg-card); backdrop-filter: blur(16px); border-radius: 16px;">
            <div class="modal-header border-bottom border-secondary px-4">
                <h5 class="modal-title" style="color: var(--text-main);" id="addUserModalLabel">Create Staff Account</h5>
                <button type="button" class="btn-close" style="filter: var(--theme-invert, invert(0));" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="#" method="POST" onsubmit="event.preventDefault();">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small text-muted">Full Name</label>
                        <input type="text" class="form-control bg-transparent border-secondary rounded-3 py-2" style="color: var(--text-main);" required placeholder="Ex: John Doe" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Employee ID</label>
                        <input type="text" class="form-control bg-transparent border-secondary rounded-3 py-2" style="color: var(--text-main);" required placeholder="Ex: 1001" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Password</label>
                        <input type="password" class="form-control bg-transparent border-secondary rounded-3 py-2" style="color: var(--text-main);" required placeholder="••••••••" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label small text-muted">Authorized System Role</label>
                        <select class="form-select bg-transparent border-secondary rounded-3 py-2" style="color: var(--text-main);">
                            <option value="" style="background-color: var(--bg-card);">-- SELECT ROLE --</option>
                            <option value="Manager" style="background-color: var(--bg-card);">Manager</option>
                            <option value="Admin" style="background-color: var(--bg-card);">Administrator</option>
                            <option value="Cashier" style="background-color: var(--bg-card);">Cashier</option>
                            <option value="Waiter" style="background-color: var(--bg-card);">Waiter</option>
                            <option value="Chef" style="background-color: var(--bg-card);">Chef</option>
                            <option value="Inventory Clerk" style="background-color: var(--bg-card);">Inventory Clerk</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top border-secondary px-4">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-3" data-bs-dismiss="modal">Discard</button>
                    <button type="submit" class="btn btn-sm btn-warning text-dark fw-bold px-4 py-2 rounded-3" data-bs-dismiss="modal">Save Employee</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border border-secondary" style="background-color: var(--bg-card); backdrop-filter: blur(16px); border-radius: 16px;">
            <div class="modal-header border-bottom border-secondary px-4">
                <h5 class="modal-title" style="color: var(--text-main);">Modify Staff Account</h5>
                <button type="button" class="btn-close" style="filter: var(--theme-invert, invert(0));" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="#" method="POST" onsubmit="event.preventDefault();">
                <input type="hidden" id="edit_Id" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small text-muted">Employee ID </label>
                        <input type="text" id="edit_UserId" class="form-control rounded-3 py-2 opacity-75 border-secondary bg-body-secondary text-muted" readonly style="cursor: not-allowed;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Full Name</label>
                        <input type="text" id="edit_Name" class="form-control bg-transparent border-secondary rounded-3 py-2" style="color: var(--text-main);" required />
                    </div>
                    <div class="mb-0">
                        <label class="form-label small text-muted">Authorized System Role</label>
                        <select id="edit_Role" class="form-select bg-transparent border-secondary rounded-3 py-2" style="color: var(--text-main);">
                            <option value="Manager" style="background-color: var(--bg-card);">Manager</option>
                            <option value="Admin" style="background-color: var(--bg-card);">Administrator</option>
                            <option value="Cashier" style="background-color: var(--bg-card);">Cashier</option>
                            <option value="Waiter" style="background-color: var(--bg-card);">Waiter</option>
                            <option value="Chef" style="background-color: var(--bg-card);">Chef</option>
                            <option value="Inventory Clerk" style="background-color: var(--bg-card);">Inventory Clerk</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top border-secondary px-4">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-warning text-dark fw-bold px-4 py-2 rounded-3" data-bs-dismiss="modal">Update Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border border-danger shadow-lg" style="background-color: var(--bg-card); border-radius: 14px;">
            <div class="modal-body text-center p-4">
                <div class="text-danger mb-3" style="font-size: 2.5rem;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h6 class="mb-1 fw-bold" style="color: var(--text-main);">Permanently Remove?</h6>
                <p class="text-muted small mb-4" id="deleteModalMessage">Are you sure you want to delete this staff user profile account?</p>
                <form action="#" method="POST" onsubmit="event.preventDefault();">
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-3 flex-grow-1" data-bs-dismiss="modal">No</button>
                        <button type="submit" class="btn btn-sm btn-danger fw-bold px-3 py-2 rounded-3 flex-grow-1" data-bs-dismiss="modal">Yes, Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="/js/admin-users.js" defer></script>