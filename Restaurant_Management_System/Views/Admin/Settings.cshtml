@{
    ViewData["Title"] = "System Settings";
    Layout = "_AdminLayout";
}

<div class="container-fluid p-0">
    <div class="mb-4">
        <h3 class="page-title mb-1" style="font-size: 1.6rem; color: var(--text-main);">System Configurations</h3>
        <p class="small mb-0" style="color: var(--text-muted);">Manage global core restaurant assets, tax tracking structures, and inventory notification rules.</p>
    </div>

    <div class="row g-4">
        <!-- LEFT COLUMN: RESTAURANT GENERAL IDENTITY PROFILE BLOCK -->
        <div class="col-xl-7 col-lg-6">
            <div class="card p-4 border h-100" style="background-color: var(--bg-card); border-color: var(--border-color) !important; border-radius: 16px;">
                <div class="d-flex align-items-center gap-2 mb-3 border-bottom pb-2" style="border-color: var(--border-color) !important;">
                    <i class="fa-solid fa-store text-primary fs-5"></i>
                    <h5 class="mb-0 fw-bold" style="color: var(--text-main);">Restaurant Profile Configuration</h5>
                </div>

                <form method="post" onsubmit="showSavePopup(event, 'Profile details updated successfully!')" class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" style="color: var(--text-main);">Restaurant Corporate Name</label>
                        <input type="text" class="form-control" style="background-color: var(--bg-main); border-color: var(--border-color); color: var(--text-main);" value="Gourmet Hub Kitchen" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" style="color: var(--text-main);">Primary Service Phone</label>
                        <input type="text" class="form-control" style="background-color: var(--bg-main); border-color: var(--border-color); color: var(--text-main);" value="+91 (995) 019-2834" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold" style="color: var(--text-main);">Corporate Contact Email Address</label>
                        <input type="email" class="form-control" style="background-color: var(--bg-main); border-color: var(--border-color); color: var(--text-main);" value="operations@gourmethub.com" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold" style="color: var(--text-main);">Physical Outlet Physical Address</label>
                        <textarea class="form-control" style="background-color: var(--bg-main); border-color: var(--border-color); color: var(--text-main);" rows="3" required>1024, Banjara Hills, Hyderabad, Telangana</textarea>
                    </div>

                    <div class="col-12 text-end mt-4">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 small fw-bold">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Update Profile
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- RIGHT COLUMN: TAX COMPLIANCE & OPERATIONAL CONTROLS BLOCK -->
        <div class="col-xl-5 col-lg-6">
            <div class="card p-4 border h-100" style="background-color: var(--bg-card); border-color: var(--border-color) !important; border-radius: 16px;">
                <div class="d-flex align-items-center gap-2 mb-3 border-bottom pb-2" style="border-color: var(--border-color) !important;">
                    <i class="fa-solid fa-percent text-warning fs-5"></i>
                    <h5 class="mb-0 fw-bold" style="color: var(--text-main);">Tax Rates & Structural Metrics</h5>
                </div>

                <form method="post" onsubmit="showSavePopup(event, 'Operational & tax configurations applied!')" class="row g-3">
                    <div class="col-12">
                        <label class="form-label small fw-semibold" style="color: var(--text-main);">Global Tax Registration Identifier (GST / TIN)</label>
                        <input type="text" class="form-control" style="background-color: var(--bg-main); border-color: var(--border-color); color: var(--text-main);" value="GSTIN9283471029B1Z4" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" style="color: var(--text-main);">Base CGST / State Tax Percentage</label>
                        <div class="input-group">
                            <input type="number" step="0.01" class="form-control" style="background-color: var(--bg-main); border-color: var(--border-color); color: var(--text-main);" value="9.00" required />
                            <span class="input-group-text border-secondary" style="background-color: var(--border-color); color: var(--text-main);">%</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" style="color: var(--text-main);">Base SGST / Federal Service Tax</label>
                        <div class="input-group">
                            <input type="number" step="0.01" class="form-control" style="background-color: var(--bg-main); border-color: var(--border-color); color: var(--text-main);" value="9.00" required />
                            <span class="input-group-text border-secondary" style="background-color: var(--border-color); color: var(--text-main);">%</span>
                        </div>
                    </div>

                    <div class="col-12 mt-4 pt-2 border-top" style="border-color: var(--border-color) !important;">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <i class="fa-solid fa-triangle-exclamation text-danger"></i>
                            <h6 class="mb-0 fw-bold" style="color: var(--text-main);">System Inventory Settings</h6>
                        </div>
                        <label class="form-label small fw-semibold" style="color: var(--text-main);">Low Stock Notification Lower Limit Threshold</label>
                        <div class="input-group">
                            <input type="number" class="form-control" style="background-color: var(--bg-main); border-color: var(--border-color); color: var(--text-main);" value="15" required />
                            <span class="input-group-text border-secondary" style="background-color: var(--border-color); color: var(--text-main);">Units</span>
                        </div>
                        <small class="text-muted d-block mt-1">Triggers background platform dashboard item alerting when current component counts plunge past this boundary level.</small>
                    </div>

                    <div class="col-12 text-end mt-4">
                        <button type="submit" class="btn btn-warning rounded-pill text-dark px-4 py-2 small fw-bold">
                            <i class="fa-solid fa-sliders me-1"></i> Apply Configurations
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<!--Just for pop up , later remove while connecting with backend-->
@section Scripts {
    <script>
        function showSavePopup(event, successMessage) {
            event.preventDefault();

            const alertDiv = document.createElement('div');
            // FIXED: Using adaptive theme colors instead of layout styles to keep it fully visible in light mode too
            alertDiv.className = 'position-fixed bottom-0 end-0 m-4 p-3 rounded-3 shadow d-flex align-items-center gap-2 border';
            alertDiv.style.backgroundColor = 'var(--bg-card)';
            alertDiv.style.borderColor = '#10b981';
            alertDiv.style.color = 'var(--text-main)';
            alertDiv.style.zIndex = '9999';
            alertDiv.style.transition = 'all 0.4s ease';
            alertDiv.style.opacity = '0';
            alertDiv.style.transform = 'translateY(20px)';

            alertDiv.innerHTML = `
                <i class="fa-solid fa-circle-check text-success fs-5"></i>
                <div class="fw-semibold small">${successMessage}</div>
            `;

            document.body.appendChild(alertDiv);

            setTimeout(() => {
                alertDiv.style.opacity = '1';
                alertDiv.style.transform = 'translateY(0)';
            }, 10);

            setTimeout(() => {
                alertDiv.style.opacity = '0';
                alertDiv.style.transform = 'translateY(20px)';
                setTimeout(() => alertDiv.remove(), 400);
            }, 3000);
        }
    </script>
}