@model Restaurant_Management_System.Models.SystemSetting

@{
    ViewData["Title"] = "System Settings";
    Layout = "_AdminLayout";
}

<div class="page-settings container-fluid p-0">
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h3 class="page-title mb-1" style="font-size: 1.6rem; color: var(--text-main);">System Configurations</h3>
            <p class="small mb-0" style="color: var(--text-muted);">Manage global core restaurant assets, tax tracking structures, and inventory notification rules.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success d-flex align-items-center gap-2 px-3 py-2 m-0 border-0 shadow-sm animate-fade-in"
                 style="border-radius: 12px; background-color: rgba(16, 185, 129, 0.15); color: #10b981;">
                <i class="fa-solid fa-circle-check fs-5"></i>
                <span class="small fw-semibold">@TempData["SuccessMessage"]</span>
            </div>
        }
    </div>

    <!-- Master form wrapping both cards so either button successfully sends the full model state to the DB -->
    <form asp-controller="Admin" asp-action="UpdateSettings" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="row g-4">
            <!-- LEFT COLUMN: RESTAURANT GENERAL IDENTITY PROFILE BLOCK -->
            <div class="col-xl-7 col-lg-6">
                <div class="card p-4 border h-100" style="background-color: var(--bg-card); border-color: var(--border-color) !important; border-radius: 16px;">
                    <div class="d-flex align-items-center gap-2 mb-3 border-bottom pb-2" style="border-color: var(--border-color) !important;">
                        <i class="fa-solid fa-store text-primary fs-5"></i>
                        <h5 class="mb-0 fw-bold" style="color: var(--text-main);">Restaurant Profile Configuration</h5>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" style="color: var(--text-main);">Restaurant Corporate Name</label>
                            <input type="text" asp-for="RestaurantName" class="form-control" style="background-color: var(--bg-main); border-color: var(--border-color); color: var(--text-main);" required />
                            <span asp-validation-for="RestaurantName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" style="color: var(--text-main);">Primary Service Phone</label>
                            <input type="text" asp-for="PrimaryPhone" class="form-control" style="background-color: var(--bg-main); border-color: var(--border-color); color: var(--text-main);" required />
                            <span asp-validation-for="PrimaryPhone" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold" style="color: var(--text-main);">Corporate Contact Email Address</label>
                            <input type="email" asp-for="CorporateEmail" class="form-control" style="background-color: var(--bg-main); border-color: var(--border-color); color: var(--text-main);" required />
                            <span asp-validation-for="CorporateEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold" style="color: var(--text-main);">Physical Outlet Physical Address</label>
                            <textarea asp-for="PhysicalAddress" class="form-control" style="background-color: var(--bg-main); border-color: var(--border-color); color: var(--text-main);" rows="3" required></textarea>
                            <span asp-validation-for="PhysicalAddress" class="text-danger small"></span>
                        </div>

                        <!-- Restored original left-side individual action button inside the card box layout -->
                        <div class="col-12 text-end mt-4">
                            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 small fw-bold">
                                <i class="fa-solid fa-floppy-disk me-1"></i> Update Profile
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: TAX COMPLIANCE & OPERATIONAL CONTROLS BLOCK -->
            <div class="col-xl-5 col-lg-6">
                <div class="card p-4 border h-100" style="background-color: var(--bg-card); border-color: var(--border-color) !important; border-radius: 16px;">
                    <div class="d-flex align-items-center gap-2 mb-3 border-bottom pb-2" style="border-color: var(--border-color) !important;">
                        <i class="fa-solid fa-percent text-warning fs-5"></i>
                        <h5 class="mb-0 fw-bold" style="color: var(--text-main);">Tax Rates & Structural Metrics</h5>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-semibold" style="color: var(--text-main);">Global Tax Registration Identifier (GST / TIN)</label>
                            <input type="text" asp-for="TaxIdentifier" class="form-control" style="background-color: var(--bg-main); border-color: var(--border-color); color: var(--text-main);" required />
                            <span asp-validation-for="TaxIdentifier" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" style="color: var(--text-main);">Base CGST / Central Tax Percentage</label>
                            <div class="input-group">
                                <input type="number" step="0.01" asp-for="BaseCgstPercentage" class="form-control" style="background-color: var(--bg-main); border-color: var(--border-color); color: var(--text-main);" required />
                                <span class="input-group-text border-secondary" style="background-color: var(--border-color); color: var(--text-main);">%</span>
                            </div>
                            <span asp-validation-for="BaseCgstPercentage" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" style="color: var(--text-main);">Base SGST / State Tax Percentage</label>
                            <div class="input-group">
                                <input type="number" step="0.01" asp-for="BaseSgstPercentage" class="form-control" style="background-color: var(--bg-main); border-color: var(--border-color); color: var(--text-main);" required />
                                <span class="input-group-text border-secondary" style="background-color: var(--border-color); color: var(--text-main);">%</span>
                            </div>
                            <span asp-validation-for="BaseSgstPercentage" class="text-danger small"></span>
                        </div>

                       
                        <!-- Restored original right-side configuration utility action button inside card container context -->
                        <div class="col-12 text-end mt-4">
                            <button type="submit" class="btn btn-warning rounded-pill text-dark px-4 py-2 small fw-bold">
                                <i class="fa-solid fa-sliders me-1"></i> Apply Configurations
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        const toastAlert = document.querySelector('.alert');
        if (toastAlert) {
        setTimeout(() => {
        toastAlert.style.transition = 'opacity 0.5s ease-out';
        toastAlert.style.opacity = '0';
        setTimeout(() => toastAlert.remove(), 500);
        }, 4000);
        }
        });
    </script>
}